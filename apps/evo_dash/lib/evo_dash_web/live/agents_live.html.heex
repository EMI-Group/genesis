<EvoDashWeb.Layouts.app flash={@flash} current_page={:agents}>
  <div>
    <p class="text-base-content/60 text-sm">Visualize running agents and their relationships</p>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 mt-4">
    <!-- Agent Tree View -->
    <div class="xl:col-span-2">
      <div class="card bg-base-100 shadow-sm border border-base-200 rounded-2xl">
        <div class="card-body p-6">
          <h3 class="card-title mb-4">
            <.icon name="hero-squares-2x2" class="size-5" /> Agent Tree
          </h3>

          <%= if @agents == [] do %>
            <div class="text-center py-16 text-base-content/50">
              <.icon name="hero-server" class="size-20 mx-auto mb-4 opacity-40" />
              <p class="text-lg">No agents currently registered</p>
              <p class="text-sm mt-2">Start a task from the dashboard to see agents here.</p>
            </div>
          <% else %>
            <div class="space-y-2 font-mono text-sm">
              <EvoDashWeb.AgentsComponents.path_tree
                nodes={@path_tree}
                depth={0}
                selected_id={@selected_agent_id}
              />
            </div>
          <% end %>
        </div>
      </div>

<!-- Legend -->
      <div class="card bg-base-100 shadow-sm border border-base-200 rounded-2xl mt-6">
        <div class="card-body p-4">
          <h4 class="font-semibold text-sm mb-3">Status Legend</h4>
          <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-base-content/20"></span>
              <span>Pending</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-success"></span>
              <span>Running</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-warning"></span>
              <span>Waiting</span>
            </div>
          </div>
        </div>
      </div>
    </div>

<!-- Agent Details Panel -->
    <div class="xl:col-span-1">
      <div class="card bg-base-100 shadow-sm border border-base-200 rounded-2xl sticky top-16">
        <div class="card-body p-6">
          <%= if @selected_agent_id do %>
            <% agent = Enum.find(@agents, &(&1.id == @selected_agent_id)) %>
            <%= if agent do %>
              <div class="flex items-center justify-between mb-4">
                <h3 class="card-title">
                  <.icon name="hero-identification" class="size-5" /> #{agent.id}
                </h3>
                <button
                  class="btn btn-sm btn-ghost btn-circle"
                  phx-click="close_details"
                >
                  <.icon name="hero-x-mark" class="size-4" />
                </button>
              </div>
              
<!-- Status Badge -->
              <div class="mb-4">
                <div class={["badge badge-lg badge-outline", agent_status_border(agent.status), agent_status_bg(agent.status)]}>
                  <.icon name={agent_status_icon(agent.status)} class={"size-4 mr-1 #{agent_status_color(agent.status)}"} />
                  <span class={agent_status_color(agent.status)}>{String.upcase(to_string(agent.status))}</span>
                </div>
              </div>
              
<!-- Details -->
              <div class="space-y-4">
                <div>
                  <h4 class="text-xs font-semibold uppercase text-base-content/60 mb-1">
                    Agent Module
                  </h4>
                  <code class="text-xs bg-base-200 px-2 py-1 rounded block break-all">
                    {inspect(agent.agent_module)}
                  </code>
                </div>

                <div>
                  <h4 class="text-xs font-semibold uppercase text-base-content/60 mb-1">
                    Objective
                  </h4>
                  <p class="text-sm bg-base-200 p-3 rounded">
                    {String.slice(agent.objective, 0, 150)}{if String.length(agent.objective) >
                                                                 150,
                                                               do: "..."}
                    <%= if String.length(agent.objective) > 150 do %>
                      <button
                        class="btn btn-xs btn-ghost px-2 ml-2 text-base-content/50 hover:text-base-content"
                        phx-click="view_full_objective"
                        title="View Full Objective"
                      >
                        <.icon name="hero-arrows-pointing-out" class="size-3" />
                      </button>
                    <% end %>
                  </p>
                </div>

                <div>
                  <h4 class="text-xs font-semibold uppercase text-base-content/60 mb-1">
                    Context Path
                  </h4>
                  <code class="text-xs bg-base-200 px-2 py-1 rounded block break-all">
                    {agent.context_path || "N/A"}
                  </code>
                </div>

                <div>
                  <h4 class="text-xs font-semibold uppercase text-base-content/60 mb-1">
                    Worktree
                  </h4>
                  <code class="text-xs bg-base-200 px-2 py-1 rounded block break-all">
                    {agent.worktree || "Not assigned"}
                  </code>
                </div>

                <div class="grid grid-cols-4 gap-2">
                  <div>
                    <h4 class="text-xs font-semibold uppercase text-base-content/50 mb-1">
                      Depth
                    </h4>
                    <span class="text-sm">{agent.depth}</span>
                  </div>

                  <div>
                    <h4 class="text-xs font-semibold uppercase text-base-content/50 mb-1">
                      Retries
                    </h4>
                    <span class="text-sm">{agent.retries}</span>
                  </div>

                  <%= if agent.current_commit do %>
                    <div>
                      <h4 class="text-xs font-semibold uppercase text-base-content/60 mb-1">
                        Current Commit
                      </h4>
                      <code class="text-xs bg-base-200 px-2 py-1 rounded">
                        {String.slice(agent.current_commit, 0, 7)}
                      </code>
                    </div>
                  <% end %>

                  <%= if agent.base_commit do %>
                    <div>
                      <h4 class="text-xs font-semibold uppercase text-base-content/60 mb-1">
                        Base Commit
                      </h4>
                      <code class="text-xs bg-base-200 px-2 py-1 rounded">
                        {String.slice(agent.base_commit, 0, 7)}
                      </code>
                    </div>
                  <% end %>
                </div>

                <%= if agent.parent_id do %>
                  <div>
                    <h4 class="text-xs font-semibold uppercase text-base-content/60 mb-1">
                      Parent Agent
                    </h4>
                    <button
                      class="btn btn-sm btn-ghost btn-xs"
                      phx-click="select_agent"
                      phx-value-id={agent.parent_id}
                    >
                      #{agent.parent_id}
                    </button>
                  </div>
                <% end %>

                <%= if agent.pending_sub_agents != [] do %>
                  <div>
                    <h4 class="text-xs font-semibold uppercase text-base-content/60 mb-1">
                      Pending SubAgents
                    </h4>
                    <div class="flex flex-wrap gap-1 mt-1">
                      <%= for sub_id <- agent.pending_sub_agents do %>
                        <button
                          class="badge badge-ghost btn-xs cursor-pointer"
                          phx-click="select_agent"
                          phx-value-id={sub_id}
                        >
                          #{sub_id}
                        </button>
                      <% end %>
                    </div>
                  </div>
                <% end %>

                <%= if map_size(agent.sub_agent_results) > 0 do %>
                  <div>
                    <h4 class="text-xs font-semibold uppercase text-base-content/60 mb-1">
                      SubAgent Results
                    </h4>
                    <div class="text-xs bg-base-200 p-2 rounded max-h-32 overflow-y-auto">
                      <%= for {sub_id, result} <- agent.sub_agent_results do %>
                        <div class="mb-1">
                          <span class="font-semibold">#{sub_id}:</span>
                          <span class="ml-1">{inspect(result, limit: 50)}</span>
                        </div>
                      <% end %>
                    </div>
                  </div>
                <% end %>

                <div>
                  <h4 class="text-xs font-semibold uppercase text-base-content/60 mb-1">
                    Children
                  </h4>
                  <%= if agent.has_children do %>
                    <div class="flex flex-wrap gap-1 mt-1">
                      <%= for {child_id, child_status} <- agent.children do %>
                        <button
                          class={["badge badge-sm btn-xs cursor-pointer badge-outline", agent_status_border(child_status), agent_status_color(child_status)]}
                          phx-click="select_agent"
                          phx-value-id={child_id}
                        >
                          #{child_id}
                        </button>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="text-sm text-base-content/50">None</span>
                  <% end %>
                </div>

                <!-- Chat History -->
                <div class="mt-6">
                  <h4 class="text-xs font-semibold uppercase text-base-content/60 mb-2">
                    Chat History / Session Memory
                  </h4>
                  <%= if agent.history && agent.history != [] do %>
                    <div class="bg-base-200 rounded-lg max-h-96 overflow-y-auto">
                      <div class="divide-y divide-base-300">
                        <%= for {entry, index} <- Enum.with_index(agent.history) do %>
                          <div class="p-3 hover:bg-base-300/50">
                            <div class="flex items-center gap-2 mb-1">
                              <.icon
                                name={history_entry_icon(entry.type)}
                                class="size-4 shrink-0"
                              />
                              <span class={[
                                "text-xs font-semibold",
                                history_entry_color(entry.type)
                              ]}>
                                {entry.type}
                              </span>
                              <button
                                class="btn btn-xs btn-ghost px-2 ml-2 text-base-content/50 hover:text-base-content"
                                phx-click="view_full_message"
                                phx-value-index={index}
                                title="View Full Message"
                              >
                                <.icon name="hero-arrows-pointing-out" class="size-3" />
                              </button>
                              <span class="text-xs text-base-content/40 ml-auto">
                                {format_turn(entry.turn)}
                              </span>
                            </div>
                            <%= case entry.type do %>
                              <% "USER_PROMPT" -> %>
                                <div class="text-sm mt-1 bg-info/10 p-2 rounded">
                                  {entry.data.content}
                                </div>
                              <% "THOUGHT_CHUNK" -> %>
                                <div class="text-sm mt-1">
                                  {entry.data.text}
                                </div>
                              <% "TOOL_CALL_START" -> %>
                                <div class="text-xs mt-1 bg-accent/10 p-2 rounded text-accent">
                                  <div class="font-semibold">{entry.data.name}</div>
                                  <pre class="mt-1 overflow-x-auto"><%= inspect(entry.data.args, limit: :infinity) %></pre>
                                </div>
                              <% "COMPLETE" -> %>
                                <% result_text =
                                  if is_map(entry.data.result),
                                    do: entry.data.result.result,
                                    else: entry.data.result %>
                                <div class="text-sm mt-1 bg-success/10 p-2 rounded text-success">
                                  {String.slice(result_text, 0, 500)}{if String.length( result_text) > 500, do: "..."}
                                </div>
                              <% "ERROR" -> %>
                                <div class="text-sm mt-1 bg-error/10 p-2 rounded text-error">
                                  {entry.data.error}
                                </div>
                              <% "RETRY" -> %>
                                <div class="text-sm mt-1 bg-warning/10 p-2 rounded text-warning">
                                  <div class="font-semibold">
                                    Retry attempt {entry.data.attempt}
                                  </div>
                                  <div class="text-xs mt-1">
                                    {String.slice(entry.data.reason, 0, 200)}{if String.length( entry.data.reason) > 200, do: "..."}
                                  </div>
                                </div>
                              <% "RETRY_DISPATCH" -> %>
                                <div class="text-sm mt-1 bg-warning/10 p-2 rounded text-warning">
                                  <div class="font-semibold">
                                    Retry #{entry.data.attempt} - Starting with {entry.data.backoff_seconds}s backoff
                                  </div>
                                  <div class="text-xs mt-1">
                                    Worktree: {Path.basename(entry.data.worktree)}
                                  </div>
                                </div>
                              <% "QUEUED" -> %>
                                <div class="text-sm mt-1 bg-base-200 p-2 rounded">
                                  {entry.data.message}
                                </div>
                              <% "CONTEXT_TREE" -> %>
                                <details class="text-xs mt-1">
                                  <summary class="cursor-pointer text-secondary">
                                    View Context (Turn {entry.data.turn})
                                  </summary>
                                  <pre class="mt-2 bg-secondary/10 p-2 rounded overflow-x-auto text-secondary"><%= entry.data.content %></pre>
                                </details>
                              <% "system" -> %>
                                <div class="mt-1 space-y-2">
                                  <%= if entry.data.content && String.trim(entry.data.content) != "" do %>
                                    <div class="text-sm bg-accent/10 p-2 rounded text-accent">
                                      {String.slice(entry.data.content, 0, 300)}{if String.length(entry.data.content) > 300, do: "..."}
                                    </div>
                                  <% end %>
                                </div>
                              <% "user" -> %>
                                <div class="mt-1">
                                  <%= if entry.data.content && String.trim(entry.data.content) != "" do %>
                                    <div class="text-sm bg-info/10 p-2 rounded text-info">
                                      {String.slice(entry.data.content, 0, 300)}{if String.length(entry.data.content) > 300, do: "..."}
                                    </div>
                                  <% else %>
                                    <div class="text-sm text-base-content/50 italic">&lt;empty message&gt;</div>
                                  <% end %>
                                </div>
                              <% "assistant" -> %>
                                <div class="mt-1 space-y-2">
                                  <%= if entry.data.reasoning_details do %>
                                    <div class="text-xs bg-warning/10 p-2 rounded text-warning">
                                      <div class="font-semibold mb-1">Thinking</div>
                                      <div>{String.slice(format_reasoning_details(entry.data.reasoning_details) || "", 0, 200)}{if String.length(format_reasoning_details(entry.data.reasoning_details) || "") > 200, do: "..."}</div>
                                    </div>
                                  <% end %>
                                  <%= if entry.data.tool_calls && entry.data.tool_calls != [] do %>
                                    <div class="text-xs bg-secondary/10 p-2 rounded text-secondary">
                                      <div class="font-semibold mb-1">Tool Calls ({length(entry.data.tool_calls)})</div>
                                      <div class="space-y-1">
                                        <%= for call <- entry.data.tool_calls do %>
                                          <div class="flex items-center gap-2">
                                            <span class="font-mono">{tool_call_name(call)}</span>
                                          </div>
                                        <% end %>
                                      </div>
                                    </div>
                                  <% end %>
                                  <%= if entry.data.content && String.trim(entry.data.content) != "" do %>
                                    <div class="text-sm bg-warning/10 p-2 rounded text-warning">
                                      {String.slice(entry.data.content, 0, 300)}{if String.length(entry.data.content) > 300, do: "..."}
                                    </div>
                                  <% else %>
                                    <div class="text-sm text-base-content/50 italic">&lt;no text content&gt;</div>
                                  <% end %>
                                </div>
                              <% "tool" -> %>
                                <div class="mt-1 space-y-2">
                                  <%= if entry.data.tool_name do %>
                                    <div class="text-xs bg-success/20 px-2 py-1 rounded font-mono">
                                      Tool Result: {entry.data.tool_name}
                                    </div>
                                  <% end %>
                                  <%= if entry.data.content && String.trim(entry.data.content) != "" do %>
                                    <div class="text-sm bg-success/10 p-2 rounded text-success max-h-48 overflow-y-auto">
                                      <pre class="text-xs whitespace-pre-wrap">{String.slice(entry.data.content, 0, 500)}{if String.length(entry.data.content) > 500, do: "\n...[truncated]"}</pre>
                                    </div>
                                  <% else %>
                                    <div class="text-sm text-base-content/50 italic">&lt;empty result&gt;</div>
                                  <% end %>
                                </div>
                              <% _ -> %>
                                <pre class="text-xs mt-1 overflow-x-auto bg-base-200 p-2 rounded"><%= inspect(entry.data, limit: :infinity) %></pre>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  <% else %>
                    <div class="text-sm text-base-content/60 bg-base-200 p-4 rounded-lg text-center">
                      No history recorded yet
                    </div>
                  <% end %>
                </div>
              </div>
            <% else %>
              <p class="text-base-content/50">Agent not found</p>
            <% end %>
          <% else %>
            <div class="text-center py-16 text-base-content/50">
              <.icon name="hero-finger-pointing" class="size-20 mx-auto mb-4 opacity-40" />
              <p class="text-lg">Select an agent to view details</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Full Message Modal -->
  <%= if @selected_history_entry do %>
    <div class="modal modal-open bg-black/50" id="full-message-modal">
      <div class="modal-box w-11/12 max-w-5xl">
        <h3 class="font-bold text-lg mb-4 flex items-center gap-2">
          <.icon name={history_entry_icon(@selected_history_entry.type)} class="size-5" />
          {@selected_history_entry.type}
          <span class="text-sm font-normal text-base-content/50 ml-auto">
            {format_turn(@selected_history_entry.turn)}
          </span>
        </h3>

        <div class="bg-base-200 p-4 rounded-lg overflow-x-auto max-h-[70vh] overflow-y-auto">
          <%= case @selected_history_entry.type do %>
            <% "USER_PROMPT" -> %>
              <pre class="text-sm whitespace-pre-wrap"><%= @selected_history_entry.data.content %></pre>
            <% "THOUGHT_CHUNK" -> %>
              <pre class="text-sm whitespace-pre-wrap"><%= @selected_history_entry.data.text %></pre>
            <% "TOOL_CALL_START" -> %>
              <div class="font-semibold mb-2">{@selected_history_entry.data.name}</div>
              <pre class="text-sm"><%= inspect(@selected_history_entry.data.args, pretty: true, limit: :infinity) %></pre>
            <% "COMPLETE" -> %>
              <% result_text =
                if is_map(@selected_history_entry.data.result),
                  do: @selected_history_entry.data.result.result,
                  else: @selected_history_entry.data.result %>
              <pre class="text-sm whitespace-pre-wrap"><%= result_text %></pre>
            <% "ERROR" -> %>
              <pre class="text-sm whitespace-pre-wrap text-error"><%= @selected_history_entry.data.error %></pre>
            <% "RETRY" -> %>
              <div class="font-semibold mb-2">
                Retry attempt {@selected_history_entry.data.attempt}
              </div>
              <pre class="text-sm whitespace-pre-wrap"><%= @selected_history_entry.data.reason %></pre>
            <% "CONTEXT_TREE" -> %>
              <pre class="text-sm whitespace-pre-wrap"><%= @selected_history_entry.data.content %></pre>
            <% "system" -> %>
              <pre class="text-sm whitespace-pre-wrap text-accent"><%= @selected_history_entry.data.content %></pre>
            <% "user" -> %>
              <pre class="text-sm whitespace-pre-wrap text-info"><%= @selected_history_entry.data.content %></pre>
            <% "assistant" -> %>
              <div class="space-y-4">
                <%= if @selected_history_entry.data.reasoning_details do %>
                  <div>
                    <h4 class="font-semibold text-warning mb-2">Thinking</h4>
                    <pre class="text-sm bg-warning/10 p-3 rounded overflow-x-auto"><%= format_reasoning_details(@selected_history_entry.data.reasoning_details) %></pre>
                  </div>
                <% end %>
                <%= if @selected_history_entry.data.tool_calls && @selected_history_entry.data.tool_calls != [] do %>
                  <div>
                    <h4 class="font-semibold text-secondary mb-2">Tool Calls</h4>
                    <div class="space-y-2">
                      <%= for call <- @selected_history_entry.data.tool_calls do %>
                        <div class="bg-secondary/10 p-3 rounded">
                          <div class="font-mono font-semibold mb-1">{tool_call_name(call)}</div>
                          <pre class="text-xs overflow-x-auto"><%= tool_call_arguments(call) %></pre>
                        </div>
                      <% end %>
                    </div>
                  </div>
                <% end %>
                <%= if @selected_history_entry.data.content && String.trim(@selected_history_entry.data.content) != "" do %>
                  <div>
                    <h4 class="font-semibold text-warning mb-2">Response</h4>
                    <pre class="text-sm whitespace-pre-wrap bg-warning/10 p-3 rounded"><%= @selected_history_entry.data.content %></pre>
                  </div>
                <% end %>
              </div>
            <% "tool" -> %>
              <div class="space-y-4">
                <%= if @selected_history_entry.data.tool_name do %>
                  <h4 class="font-semibold text-success">Tool Result: {@selected_history_entry.data.tool_name}</h4>
                <% end %>
                <pre class="text-sm whitespace-pre-wrap bg-success/10 p-3 rounded max-h-[60vh] overflow-y-auto"><%= @selected_history_entry.data.content %></pre>
              </div>
            <% _ -> %>
              <pre class="text-sm"><%= inspect(@selected_history_entry.data, pretty: true, limit: :infinity) %></pre>
          <% end %>
        </div>

        <div class="modal-action">
          <button class="btn" phx-click="close_message_modal">Close</button>
        </div>
      </div>

      <div class="modal-backdrop" phx-click="close_message_modal">
        <button class="cursor-default">close</button>
      </div>
    </div>
  <% end %>

  <!-- Full Objective Modal -->
  <%= if @selected_objective do %>
    <div class="modal modal-open bg-black/50" id="full-objective-modal">
      <div class="modal-box w-11/12 max-w-5xl">
        <h3 class="font-bold text-lg mb-4 flex items-center gap-2">
          <.icon name="hero-document-text" class="size-5" />
          Full Objective
        </h3>

        <div class="bg-base-200 p-4 rounded-lg overflow-x-auto max-h-[70vh] overflow-y-auto">
          <pre class="text-sm whitespace-pre-wrap"><%= @selected_objective %></pre>
        </div>

        <div class="modal-action">
          <button class="btn" phx-click="close_objective_modal">Close</button>
        </div>
      </div>

      <div class="modal-backdrop" phx-click="close_objective_modal">
        <button class="cursor-default">close</button>
      </div>
    </div>
  <% end %>
</EvoDashWeb.Layouts.app>
