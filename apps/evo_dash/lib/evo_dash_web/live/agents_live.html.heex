<EvoDashWeb.Layouts.flash_group flash={@flash} />

<div class="container mx-auto px-4 py-8">
  <.header>
    Agent Inspector
    <:subtitle>
      Visualize running agents and their relationships
    </:subtitle>
    <:actions>
      <a href="/" class="btn btn-sm btn-ghost">
        <.icon name="hero-arrow-left" class="size-4" />
        Back to Dashboard
      </a>
    </:actions>
  </.header>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Agent Tree View -->
    <div class="lg:col-span-2">
      <div class="card bg-base-100 shadow-sm border border-base-200">
        <div class="card-body p-6">
          <h3 class="card-title mb-4">
            <.icon name="hero-squares-2x2" class="size-5" />
            Agent Tree
          </h3>

          <%= if @agents == [] do %>
            <div class="text-center py-12 text-base-content/50">
              <.icon name="hero-server" class="size-16 mx-auto mb-4" />
              <p>No agents currently registered.</p>
              <p class="text-sm mt-2">Start a task from the dashboard to see agents here.</p>
            </div>
          <% else %>
            <div class="space-y-2 font-mono text-sm">
              <EvoDashWeb.AgentsComponents.agent_tree
                agents={@agents}
                parent_id={nil}
                depth={0}
                selected_id={@selected_agent_id}
              />
            </div>
          <% end %>
        </div>
      </div>

      <!-- Legend -->
      <div class="card bg-base-100 shadow-sm border border-base-200 mt-6">
        <div class="card-body p-4">
          <h4 class="font-semibold text-sm mb-3">Status Legend</h4>
          <div class="flex flex-wrap gap-4 text-sm">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-gray-400 dark:bg-gray-600"></span>
              <span>Pending</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-green-500 dark:bg-green-600"></span>
              <span>Running</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-yellow-500 dark:bg-yellow-600"></span>
              <span>Waiting (for sub-agents)</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Agent Details Panel -->
    <div class="lg:col-span-1">
      <div class="card bg-base-100 shadow-sm border border-base-200 sticky top-4">
        <div class="card-body p-6">
          <%= if @selected_agent_id do %>
            <% agent = Enum.find(@agents, &(&1.id == @selected_agent_id)) %>
            <%= if agent do %>
              <div class="flex items-center justify-between mb-4">
                <h3 class="card-title">
                  <.icon name="hero-identification" class="size-5" />
                  Agent #<%= agent.id %>
                </h3>
                <button
                  class="btn btn-sm btn-ghost btn-circle"
                  phx-click="close_details"
                >
                  <.icon name="hero-x-mark" class="size-4" />
                </button>
              </div>

              <!-- Status Badge -->
              <div class="mb-4">
                <div class={["badge badge-lg", status_color(agent.status)]}>
                  <.icon name={status_icon(agent.status)} class="size-4 mr-1" />
                  <%= String.upcase(to_string(agent.status)) %>
                </div>
              </div>

              <!-- Details -->
              <div class="space-y-4">
                <div>
                  <h4 class="text-xs font-semibold uppercase text-base-content/50 mb-1">Agent Module</h4>
                  <code class="text-xs bg-base-200 px-2 py-1 rounded">
                    <%= inspect(agent.agent_module) %>
                  </code>
                </div>

                <div>
                  <h4 class="text-xs font-semibold uppercase text-base-content/50 mb-1">Objective</h4>
                  <p class="text-sm bg-base-200 p-3 rounded">
                    <%= String.slice(agent.objective, 0, 150) %><%= if String.length(agent.objective) > 150, do: "..." %>
                  </p>
                </div>

                <div>
                  <h4 class="text-xs font-semibold uppercase text-base-content/50 mb-1">Context Path</h4>
                  <code class="text-xs bg-base-200 px-2 py-1 rounded block break-all">
                    <%= agent.context_path || "N/A" %>
                  </code>
                </div>

                <div>
                  <h4 class="text-xs font-semibold uppercase text-base-content/50 mb-1">Worktree</h4>
                  <code class="text-xs bg-base-200 px-2 py-1 rounded block break-all">
                    <%= agent.worktree || "Not assigned" %>
                  </code>
                </div>

                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <h4 class="text-xs font-semibold uppercase text-base-content/50 mb-1">Depth</h4>
                    <span class="text-sm"><%= agent.depth %></span>
                  </div>

                  <div>
                    <h4 class="text-xs font-semibold uppercase text-base-content/50 mb-1">Retries</h4>
                    <span class="text-sm"><%= agent.retries %></span>
                  </div>

                  <%= if agent.current_commit do %>
                    <div>
                      <h4 class="text-xs font-semibold uppercase text-base-content/50 mb-1">Current Commit</h4>
                      <code class="text-xs bg-base-200 px-2 py-1 rounded">
                        <%= String.slice(agent.current_commit, 0, 7) %>
                      </code>
                    </div>
                  <% end %>

                  <%= if agent.base_commit do %>
                    <div>
                      <h4 class="text-xs font-semibold uppercase text-base-content/50 mb-1">Base Commit</h4>
                      <code class="text-xs bg-base-200 px-2 py-1 rounded">
                        <%= String.slice(agent.base_commit, 0, 7) %>
                      </code>
                    </div>
                  <% end %>
                </div>

                <%= if agent.parent_id do %>
                  <div>
                    <h4 class="text-xs font-semibold uppercase text-base-content/50 mb-1">Parent Agent</h4>
                    <button
                      class="btn btn-sm btn-ghost btn-xs"
                      phx-click="select_agent"
                      phx-value-id={agent.parent_id}
                    >
                      Agent <%= agent.parent_id %>
                    </button>
                  </div>
                <% end %>

                <%= if agent.pending_sub_agents != [] do %>
                  <div>
                    <h4 class="text-xs font-semibold uppercase text-base-content/50 mb-1">Pending Sub-Agents</h4>
                    <div class="flex flex-wrap gap-1 mt-1">
                      <%= for sub_id <- agent.pending_sub_agents do %>
                        <button
                          class="badge badge-ghost btn-xs cursor-pointer"
                          phx-click="select_agent"
                          phx-value-id={sub_id}
                        >
                          #<%= sub_id %>
                        </button>
                      <% end %>
                    </div>
                  </div>
                <% end %>

                <%= if map_size(agent.sub_agent_results) > 0 do %>
                  <div>
                    <h4 class="text-xs font-semibold uppercase text-base-content/50 mb-1">Sub-Agent Results</h4>
                    <div class="text-xs bg-base-200 p-2 rounded max-h-32 overflow-y-auto">
                      <%= for {sub_id, result} <- agent.sub_agent_results do %>
                        <div class="mb-1">
                          <span class="font-semibold">#<%= sub_id %>:</span>
                          <span class="ml-1"><%= inspect(result, limit: 50) %></span>
                        </div>
                      <% end %>
                    </div>
                  </div>
                <% end %>

                <div>
                  <h4 class="text-xs font-semibold uppercase text-base-content/50 mb-1">Children</h4>
                  <%= if agent.has_children do %>
                    <div class="flex flex-wrap gap-1 mt-1">
                      <%= for {child_id, child_status} <- agent.children do %>
                        <button
                          class={["badge btn-xs cursor-pointer", status_color(child_status)]}
                          phx-click="select_agent"
                          phx-value-id={child_id}
                        >
                          #<%= child_id %>
                        </button>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="text-sm text-base-content/50">None</span>
                  <% end %>
                </div>

                <!-- Chat History -->
                <div class="mt-6">
                  <h4 class="text-xs font-semibold uppercase text-base-content/50 mb-2">
                    Chat History / Session Memory
                  </h4>
                  <%= if agent.history && agent.history != [] do %>
                    <div class="bg-base-200 rounded-lg max-h-96 overflow-y-auto">
                      <div class="divide-y divide-base-300">
                        <%= for entry <- agent.history do %>
                          <div class="p-3 hover:bg-base-300/50">
                            <div class="flex items-center gap-2 mb-1">
                              <.icon
                                name={history_entry_icon(entry.type)}
                                class="size-4 shrink-0"
                              />
                              <span class={["text-xs font-semibold", history_entry_color(entry.type)]}>
                                <%= entry.type %>
                              </span>
                              <span class="text-xs text-base-content/40 ml-auto">
                                <%= format_timestamp(entry.timestamp) %>
                              </span>
                            </div>
                            <%= case entry.type do %>
                              <% "USER_PROMPT" -> %>
                                <div class="text-sm mt-1 bg-blue-50 dark:bg-blue-900/20 p-2 rounded">
                                  <%= entry.data.content %>
                                </div>
                              <% "THOUGHT_CHUNK" -> %>
                                <div class="text-sm mt-1">
                                  <%= entry.data.text %>
                                </div>
                              <% "TOOL_CALL_START" -> %>
                                <div class="text-xs mt-1 bg-orange-50 dark:bg-orange-900/20 p-2 rounded text-orange-900 dark:text-orange-200">
                                  <div class="font-semibold"><%= entry.data.name %></div>
                                  <pre class="mt-1 overflow-x-auto"><%= inspect(entry.data.args, limit: :infinity) %></pre>
                                </div>
                              <% "COMPLETE" -> %>
                                <div class="text-sm mt-1 bg-emerald-50 dark:bg-emerald-900/20 p-2 rounded text-emerald-900 dark:text-emerald-200">
                                  <%= String.slice(entry.data.result, 0, 500) %><%= if String.length(entry.data.result) > 500, do: "..." %>
                                </div>
                              <% "ERROR" -> %>
                                <div class="text-sm mt-1 bg-red-50 dark:bg-red-900/20 p-2 rounded text-red-700 dark:text-red-400">
                                  <%= entry.data.error %>
                                </div>
                              <% "RETRY" -> %>
                                <div class="text-sm mt-1 bg-orange-50 dark:bg-orange-900/20 p-2 rounded text-orange-900 dark:text-orange-200">
                                  <div class="font-semibold">Retry attempt <%= entry.data.attempt %></div>
                                  <div class="text-xs mt-1"><%= String.slice(entry.data.reason, 0, 200) %><%= if String.length(entry.data.reason) > 200, do: "..." %></div>
                                </div>
                              <% "RETRY_DISPATCH" -> %>
                                <div class="text-sm mt-1 bg-amber-50 dark:bg-amber-900/20 p-2 rounded text-amber-900 dark:text-amber-200">
                                  <div class="font-semibold">Retry #<%= entry.data.attempt %> - Starting with <%= entry.data.backoff_seconds %>s backoff</div>
                                  <div class="text-xs mt-1">Worktree: <%= Path.basename(entry.data.worktree) %></div>
                                </div>
                              <% "QUEUED" -> %>
                                <div class="text-sm mt-1 bg-gray-100 dark:bg-gray-800/60 p-2 rounded">
                                  <%= entry.data.message %>
                                </div>
                              <% "CONTEXT_TREE" -> %>
                                <details class="text-xs mt-1">
                                  <summary class="cursor-pointer text-purple-600 dark:text-purple-400">
                                    View Context (Turn <%= entry.data.turn %>)
                                  </summary>
                                  <pre class="mt-2 bg-purple-50 dark:bg-purple-900/20 p-2 rounded overflow-x-auto text-purple-900 dark:text-purple-200"><%= entry.data.content %></pre>
                                </details>
                              <% _ -> %>
                                <pre class="text-xs mt-1 overflow-x-auto bg-base-200 dark:bg-base-300 p-2 rounded"><%= inspect(entry.data, limit: :infinity) %></pre>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  <% else %>
                    <div class="text-sm text-base-content/50 bg-base-200 p-4 rounded-lg text-center">
                      No history recorded yet
                    </div>
                  <% end %>
                </div>
              </div>
            <% else %>
              <p class="text-base-content/50">Agent not found</p>
            <% end %>
          <% else %>
            <div class="text-center py-12 text-base-content/50">
              <.icon name="hero-finger-pointing" class="size-16 mx-auto mb-4" />
              <p>Select an agent to view details</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
