<EvoDashWeb.Layouts.flash_group flash={@flash} />

<div class="container mx-auto px-4 py-8">
  <.header>
    Agent Inspector
    <:subtitle>
      Visualize running agents and their relationships
    </:subtitle>
    <:actions>
      <a href="/" class="btn btn-sm btn-ghost">
        <.icon name="hero-arrow-left" class="size-4" />
        Back to Dashboard
      </a>
    </:actions>
  </.header>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Agent Tree View -->
    <div class="lg:col-span-2">
      <div class="card bg-base-100 shadow-sm border border-base-200">
        <div class="card-body p-6">
          <h3 class="card-title mb-4">
            <.icon name="hero-squares-2x2" class="size-5" />
            Agent Tree
          </h3>

          <%= if @agents == [] do %>
            <div class="text-center py-12 text-base-content/50">
              <.icon name="hero-server" class="size-16 mx-auto mb-4" />
              <p>No agents currently registered.</p>
              <p class="text-sm mt-2">Start a task from the dashboard to see agents here.</p>
            </div>
          <% else %>
            <div class="space-y-2 font-mono text-sm">
              <EvoDashWeb.AgentsComponents.agent_tree
                agents={@agents}
                parent_id={nil}
                depth={0}
                selected_id={@selected_agent_id}
              />
            </div>
          <% end %>
        </div>
      </div>

      <!-- Legend -->
      <div class="card bg-base-100 shadow-sm border border-base-200 mt-6">
        <div class="card-body p-4">
          <h4 class="font-semibold text-sm mb-3">Status Legend</h4>
          <div class="flex flex-wrap gap-4 text-sm">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-gray-400"></span>
              <span>Pending</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-green-500"></span>
              <span>Running</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-yellow-500"></span>
              <span>Waiting (for sub-agents)</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Agent Details Panel -->
    <div class="lg:col-span-1">
      <div class="card bg-base-100 shadow-sm border border-base-200 sticky top-4">
        <div class="card-body p-6">
          <%= if @selected_agent_id do %>
            <% agent = Enum.find(@agents, &(&1.id == @selected_agent_id)) %>
            <%= if agent do %>
              <div class="flex items-center justify-between mb-4">
                <h3 class="card-title">
                  <.icon name="hero-identification" class="size-5" />
                  Agent #<%= agent.id %>
                </h3>
                <button
                  class="btn btn-sm btn-ghost btn-circle"
                  phx-click="close_details"
                >
                  <.icon name="hero-x-mark" class="size-4" />
                </button>
              </div>

              <!-- Status Badge -->
              <div class="mb-4">
                <div class={["badge badge-lg", status_color(agent.status)]}>
                  <.icon name={status_icon(agent.status)} class="size-4 mr-1" />
                  <%= String.upcase(to_string(agent.status)) %>
                </div>
              </div>

              <!-- Details -->
              <div class="space-y-4">
                <div>
                  <h4 class="text-xs font-semibold uppercase text-base-content/50 mb-1">Agent Module</h4>
                  <code class="text-xs bg-base-200 px-2 py-1 rounded">
                    <%= inspect(agent.agent_module) %>
                  </code>
                </div>

                <div>
                  <h4 class="text-xs font-semibold uppercase text-base-content/50 mb-1">Objective</h4>
                  <p class="text-sm bg-base-200 p-3 rounded">
                    <%= String.slice(agent.objective, 0, 150) %><%= if String.length(agent.objective) > 150, do: "..." %>
                  </p>
                </div>

                <div>
                  <h4 class="text-xs font-semibold uppercase text-base-content/50 mb-1">Context Path</h4>
                  <code class="text-xs bg-base-200 px-2 py-1 rounded block break-all">
                    <%= agent.context_path || "N/A" %>
                  </code>
                </div>

                <div>
                  <h4 class="text-xs font-semibold uppercase text-base-content/50 mb-1">Worktree</h4>
                  <code class="text-xs bg-base-200 px-2 py-1 rounded block break-all">
                    <%= agent.worktree || "Not assigned" %>
                  </code>
                </div>

                <div>
                  <h4 class="text-xs font-semibold uppercase text-base-content/50 mb-1">Depth</h4>
                  <span class="text-sm"><%= agent.depth %></span>
                </div>

                <div>
                  <h4 class="text-xs font-semibold uppercase text-base-content/50 mb-1">Retries</h4>
                  <span class="text-sm"><%= agent.retries %></span>
                </div>

                <%= if agent.current_commit do %>
                  <div>
                    <h4 class="text-xs font-semibold uppercase text-base-content/50 mb-1">Current Commit</h4>
                    <code class="text-xs bg-base-200 px-2 py-1 rounded">
                      <%= String.slice(agent.current_commit, 0, 7) %>
                    </code>
                  </div>
                <% end %>

                <%= if agent.base_commit do %>
                  <div>
                    <h4 class="text-xs font-semibold uppercase text-base-content/50 mb-1">Base Commit</h4>
                    <code class="text-xs bg-base-200 px-2 py-1 rounded">
                      <%= String.slice(agent.base_commit, 0, 7) %>
                    </code>
                  </div>
                <% end %>

                <%= if agent.parent_id do %>
                  <div>
                    <h4 class="text-xs font-semibold uppercase text-base-content/50 mb-1">Parent Agent</h4>
                    <button
                      class="btn btn-sm btn-ghost btn-xs"
                      phx-click="select_agent"
                      phx-value-id={agent.parent_id}
                    >
                      Agent <%= agent.parent_id %>
                    </button>
                  </div>
                <% end %>

                <%= if agent.pending_sub_agents != [] do %>
                  <div>
                    <h4 class="text-xs font-semibold uppercase text-base-content/50 mb-1">Pending Sub-Agents</h4>
                    <div class="flex flex-wrap gap-1 mt-1">
                      <%= for sub_id <- agent.pending_sub_agents do %>
                        <button
                          class="badge badge-ghost btn-xs cursor-pointer"
                          phx-click="select_agent"
                          phx-value-id={sub_id}
                        >
                          #<%= sub_id %>
                        </button>
                      <% end %>
                    </div>
                  </div>
                <% end %>

                <%= if map_size(agent.sub_agent_results) > 0 do %>
                  <div>
                    <h4 class="text-xs font-semibold uppercase text-base-content/50 mb-1">Sub-Agent Results</h4>
                    <div class="text-xs bg-base-200 p-2 rounded max-h-32 overflow-y-auto">
                      <%= for {sub_id, result} <- agent.sub_agent_results do %>
                        <div class="mb-1">
                          <span class="font-semibold">#<%= sub_id %>:</span>
                          <span class="ml-1"><%= inspect(result, limit: 50) %></span>
                        </div>
                      <% end %>
                    </div>
                  </div>
                <% end %>

                <div>
                  <h4 class="text-xs font-semibold uppercase text-base-content/50 mb-1">Children</h4>
                  <%= if agent.has_children do %>
                    <div class="flex flex-wrap gap-1 mt-1">
                      <%= for {child_id, child_status} <- agent.children do %>
                        <button
                          class={["badge btn-xs cursor-pointer", status_color(child_status)]}
                          phx-click="select_agent"
                          phx-value-id={child_id}
                        >
                          #<%= child_id %>
                        </button>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="text-sm text-base-content/50">None</span>
                  <% end %>
                </div>
              </div>
            <% else %>
              <p class="text-base-content/50">Agent not found</p>
            <% end %>
          <% else %>
            <div class="text-center py-12 text-base-content/50">
              <.icon name="hero-finger-pointing" class="size-16 mx-auto mb-4" />
              <p>Select an agent to view details</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
