<% scoped_task = if Scope.available?(assigns), do: assigns[:scoped_task] %>
<EvoDashWeb.Layouts.app
  flash={@flash}
  current_page={:agents}
  workbench_task={assigns[:task_scope_id]}
  workbench_project={scoped_task && scoped_task.project_path}
  workbench_history_scope_pending?={Loader.history_scope_pending?(assigns)}
  workbench_title={scoped_task && scoped_task.objective}
  config_status={@config_status}
  current_node_id={@current_node_id}
  remote_targets={assigns[:remote_targets] || []}
  connection_statuses={assigns[:connection_statuses] || %{}}
  current_node_name={@current_node_name}
  running_tasks={@running_tasks}
  session_list={assigns[:session_list] || []}
  session_list_loading={assigns[:session_list_loading] == true}
  session_list_error={assigns[:session_list_error]}
  current_session_id={assigns[:current_session_id]}
  pending_tasks={@pending_tasks}
  desktop_quit_confirm={@desktop_quit_confirm}
  update_status={@update_status}
  guide={@guide}
  accent_color={assigns[:accent_color] || "blue"}
>
  <%= if EvoDashWeb.RemoteGateComponents.gate_active?(assigns) do %>
    {EvoDashWeb.RemoteGateComponents.remote_connection_gate(assigns)}
  <% else %>
    <%!-- The workbench tab rail carries the page name, so this page renders no
    in-canvas title. A task-scoped view keeps its scope strip NON-scrolling: at
    xl+ the wrapper is a two-row grid (`auto` strip, `minmax(0, 1fr)` panels)
    filling `main#main-content`, so `.agents-page-layout` still resolves its
    `height: 100%` against that panel row and each panel keeps scrolling
    independently — the strip can never eat into the panels' scrollers or
    force page-level scroll. Without a task scope there is no strip and the
    panel row takes the whole height. Below xl it is normal page flow. --%>
    <div class={[
      "grid min-h-0 gap-4 xl:h-full",
      if(assigns[:task_scope_id],
        do: "xl:grid-rows-[auto_minmax(0,1fr)]",
        else: "xl:grid-rows-[minmax(0,1fr)]"
      )
    ]}>
      <header
        :if={assigns[:task_scope_id]}
        class="flex min-w-0 flex-wrap items-start justify-between gap-3"
      >
        <div id="agents-task-scope" class="min-w-0 flex-1">
          <p class="truncate text-xs text-base-content/70" title={assigns[:task_scope_id]}>
            {gettext("Task: %{id}", id: assigns[:task_scope_id])}
          </p>
          <p :if={scoped_task && scoped_task.objective} class="line-clamp-2 text-base">
            {scoped_task.objective}
          </p>
        </div>
        <.link
          id="agents-clear-task-scope"
          patch={Scope.path(nil, @current_node_id)}
          class="btn btn-sm btn-ghost shrink-0"
        >
          {gettext("All agents")}
        </.link>
      </header>
      <div class="agents-page-layout shell-fill">
        <EvoDashWeb.AgentsLive.TreePanel.tree_panel
          agents_error={@agents_error}
          agents_loading={@agents_loading}
          scoped_task_state={assigns[:scoped_task_state]}
          left_view={@left_view}
          agents={@agents}
          repo_trees={@repo_trees}
          selected_agent_id={@selected_agent_id}
          new_agent_ids={@new_agent_ids}
          changed_status_ids={@changed_status_ids}
          commit_graph={assigns[:commit_graph] || []}
          commit_graph_loading={assigns[:commit_graph_loading] == true}
          commit_graph_error={assigns[:commit_graph_error]}
          current_node_id={@current_node_id}
        />
        <EvoDashWeb.AgentsLive.DetailPanel.detail_panel assigns={assigns} />
      </div>
    </div>

    <EvoDashWeb.AgentsLive.Modals.modals
      selected_history_entry={@selected_history_entry}
      selected_objective={@selected_objective}
      send_message_agent_id={@send_message_agent_id}
      send_message_text={assigns[:send_message_text] || ""}
      id_to_display={@id_to_display}
    />
  <% end %>
</EvoDashWeb.Layouts.app>
