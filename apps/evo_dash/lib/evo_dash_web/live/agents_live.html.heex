<EvoDashWeb.Layouts.app
  flash={@flash}
  current_page={:agents}
  config_status={@config_status}
  current_node_id={@current_node_id}
  current_node_name={@current_node_name}
  running_tasks={@running_tasks}
  pending_tasks={@pending_tasks}
  desktop_quit_confirm={@desktop_quit_confirm}
  update_status={@update_status}
  guide={@guide}
  accent_color={assigns[:accent_color] || "blue"}
>
  <%= if EvoDashWeb.RemoteGateComponents.gate_active?(assigns) do %>
    {EvoDashWeb.RemoteGateComponents.remote_connection_gate(assigns)}
  <% else %>
    <!-- Fixed viewport layout: no page-level scroll on xl+, panels scroll independently -->
    <div class="agents-page-layout animate-fade-in-up animation-delay-100">
      <!-- Left Column: Tree + Legend -->
      <div class="agents-left-col">
        <%!-- Page-load failure: the last good tree stays rendered, plus this
        retry-able inline banner (no polling, no auto-retry timer). --%>
        <%= if @agents_error do %>
          <div
            id="agents-load-error"
            class="flex shrink-0 flex-wrap items-center gap-3 rounded-lg border border-error/30 bg-error/5 px-4 py-3"
          >
            <.icon name="hero-exclamation-triangle" class="size-5 shrink-0 text-error" />
            <div class="min-w-0 flex-1">
              <p class="text-sm font-medium text-error">
                {gettext("Failed to load agents from this node.")}
              </p>
              <p class="text-xs text-base-content/70 font-mono break-all">
                {inspect(@agents_error)}
              </p>
            </div>
            <button
              id="agents-load-retry"
              type="button"
              class="btn btn-sm btn-outline shrink-0"
              phx-click="retry_agents_load"
              disabled={@agents_loading}
            >
              {gettext("Retry")}
            </button>
          </div>
        <% end %>
        <!-- Agent Tree View -->
        <div class="agents-tree-panel card bg-base-100 border border-base-300 rounded-lg">
          <div class="card-body p-4">
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <.icon name="hero-squares-2x2" class="size-5 shrink-0" />
              <div class="inline-flex items-center gap-0.5 p-0.5 rounded-lg bg-base-200/60 border border-base-300">
                <button
                  id="left-view-tree"
                  type="button"
                  class={[
                    "px-2.5 py-1 text-xs font-medium rounded-md transition-colors",
                    @left_view == :tree && "bg-base-100 text-base-content shadow-sm",
                    @left_view != :tree && "text-base-content/70 hover:text-base-content"
                  ]}
                  phx-click="switch_left_view"
                  phx-value-view="tree"
                >
                  {gettext("Agent Tree")}
                </button>
                <button
                  id="left-view-commits"
                  type="button"
                  class={[
                    "px-2.5 py-1 text-xs font-medium rounded-md transition-colors",
                    @left_view == :commits && "bg-base-100 text-base-content shadow-sm",
                    @left_view != :commits && "text-base-content/70 hover:text-base-content"
                  ]}
                  phx-click="switch_left_view"
                  phx-value-view="commits"
                >
                  <%!-- zh_CN: 提交历史 —— 时间维度（git 提交图）视图 --%>
                  {gettext("Commit History")}
                </button>
              </div>
            </div>

            <%= if @left_view == :tree do %>
              <%= if @agents_loading do %>
                <div class="text-center py-16 bg-base-200/40 rounded-xl">
                  <.icon
                    name="hero-arrow-path"
                    class="size-8 mx-auto mb-4 text-base-content/60 animate-spin"
                  />
                  <%!-- 加载中提示：智能体列表从当前节点异步拉取时的占位加载态 --%>
                  <p class="text-lg text-base-content">{gettext("Loading agents…")}</p>
                </div>
              <% else %>
                <%= if @agents == [] do %>
                  <div class="text-center py-16">
                    <.icon
                      name="hero-server"
                      class="size-10 mx-auto mb-4 text-base-content/40"
                    />
                    <p class="text-lg text-base-content">
                      {gettext("No agents currently registered")}
                    </p>
                    <p class="text-sm mt-2 text-base-content/60">
                      {gettext("Start a task from the dashboard to see agents here.")}
                    </p>
                  </div>
                <% else %>
                  <div class="space-y-4">
                    <%= for {repo_name, tree_nodes} <- @repo_trees do %>
                      <div>
                        <!-- Repo Header -->
                        <div class="flex items-center gap-2 mb-2 pb-1 border-b border-base-300">
                          <.icon
                            name="hero-server-stack"
                            class="size-5 text-primary-content p-1.5 rounded-lg bg-primary"
                          />
                          <span class="min-w-0 break-all font-semibold text-sm text-base-content">{repo_name}</span>
                          <span class="text-xs text-base-content/70">({length(tree_nodes)} {gettext(
                            "directories"
                          )})</span>
                        </div>
                        <div class="space-y-4 font-mono text-sm">
                          <EvoDashWeb.AgentsComponents.path_tree
                            nodes={tree_nodes}
                            depth={0}
                            selected_id={@selected_agent_id}
                            new_agent_ids={@new_agent_ids}
                            changed_status_ids={@changed_status_ids}
                          />
                        </div>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              <% end %>
            <% else %>
              <EvoDashWeb.AgentsComponents.CommitGraphView.commit_graph_view
                repos={@commit_graph}
                selected_id={@selected_agent_id}
                loading={@commit_graph_loading}
                error={@commit_graph_error}
                node_key={@current_node_id || "local"}
              />
            <% end %>
          </div>

          <!-- Legend — compact chip cluster, bottom-right of the tree box -->
          <div class="agents-legend">
            <%= if @left_view == :tree do %>
              <span class="agents-legend-title">{gettext("Status Legend")}</span>
              <div
                id="agents-legend-pending"
                class="flex items-center gap-2"
                data-tip={
                  gettext(
                    "Agent is queued, waiting to be scheduled. May be limited by LLM or tool concurrency. Consider increasing concurrency in Settings."
                  )
                }
                phx-hook="LegendTooltip"
              >
                <span class="w-2.5 h-2.5 rounded-full bg-base-content/40"></span>
                <span>{gettext("Pending")}</span>
              </div>
              <div
                id="agents-legend-running"
                class="flex items-center gap-2"
                data-tip={gettext("Agent is actively executing its assigned task.")}
                phx-hook="LegendTooltip"
              >
                <span class="w-2.5 h-2.5 rounded-full bg-success shadow-sm shadow-success/50"></span>
                <span>{gettext("Running")}</span>
              </div>
              <div
                id="agents-legend-waiting"
                class="flex items-center gap-2"
                data-tip={
                  gettext("Agent is waiting for subagents to finish. Nothing to do but wait.")
                }
                phx-hook="LegendTooltip"
              >
                <span class="w-2.5 h-2.5 rounded-full bg-warning shadow-sm shadow-warning/50"></span>
                <span>{gettext("Waiting")}</span>
              </div>
            <% else %>
              <%!-- zh_CN: 提交图例 —— 时间维度视图（以提交为中心的纵向泳道图）的图例 --%>
              <span class="agents-legend-title">{gettext("Commit Graph Legend")}</span>
              <%!-- zh_CN: 提交 —— 每个提交画一个圆点；被多个智能体共享的同一提交只是图上「一个」圆点 --%>
              <div
                id="agents-legend-commit"
                class="flex items-center gap-2"
                data-tip={
                  gettext(
                    "One circular dot per commit. Commits shared by several agents remain a single dot. Hover a row to see its message."
                  )
                }
                phx-hook="LegendTooltip"
              >
                <span class="w-2.5 h-2.5 rounded-full bg-base-content/40"></span>
                <span>{gettext("Commit")}</span>
              </div>
              <%!-- zh_CN: 智能体泳道 —— 每个智能体占「一条」纵向泳道（一列）；父智能体在左、子智能体在右，顶部标签标明每条泳道的主人，泳道颜色按递归深度取色 --%>
              <div
                id="agents-legend-path"
                class="flex items-center gap-2"
                data-tip={
                  gettext(
                    "Each agent owns exactly one vertical lane. Parent lanes sit left, subagent lanes right; the sticky header chips name each lane, and the lane is colored by the agent's recursion depth."
                  )
                }
                phx-hook="LegendTooltip"
              >
                <%!-- Legend swatch mirrors the depth→hue formula in
                     AgentsLive.CommitGraph (depth 0 lands on this blue-violet);
                     the literal is acceptable in a static legend chip. --%>
                <span class="w-4 h-0.5 rounded-full" style="background-color: #7c38dc"></span>
                <span>{gettext("Agent lane")}</span>
              </div>
              <%!-- zh_CN: 智能体状态 —— 智能体泳道末端的最新提交圆点按该智能体的状态着色（与左侧智能体树同一色系：绿＝运行、琥珀＝等待、灰＝排队） --%>
              <div
                id="agents-legend-ring"
                class="flex items-center gap-2"
                data-tip={
                  gettext(
                    "An agent's tip dot is colored by its status — same palette as the agent tree."
                  )
                }
                phx-hook="LegendTooltip"
              >
                <span class="w-2.5 h-2.5 rounded-full bg-success"></span>
                <span>{gettext("Agent status")}</span>
              </div>
              <%!-- zh_CN: 派生边 —— 子智能体从父泳道的分叉点出发，虚线画到子泳道自己的首个提交 --%>
              <div
                id="agents-legend-spawn"
                class="flex items-center gap-2"
                data-tip={
                  gettext(
                    "A dashed branch-out from the fork commit on the parent's lane into the child's own lane, where the child's first commit sits."
                  )
                }
                phx-hook="LegendTooltip"
              >
                <span class="w-4 h-0 border-t-2 border-dashed border-base-content/60"></span>
                <span>{gettext("Spawn edge")}</span>
              </div>
              <%!-- zh_CN: 合回边 —— 虚线从子泳道的最新提交回到父泳道：真实合并、快进（父分支被直接推进到子提交）与零提交的子智能体都画成这类边 --%>
              <div
                id="agents-legend-merge"
                class="flex items-center gap-2"
                data-tip={
                  gettext(
                    "A dashed return from the child's last commit into the parent's lane — drawn for real merges, fast-forwards (the parent silently advanced to the child's tip) and children that committed nothing."
                  )
                }
                phx-hook="LegendTooltip"
              >
                <span class="w-4 h-0 border-t-2 border-dashed border-base-content/60"></span>
                <span>{gettext("Merge-back edge")}</span>
              </div>
              <%!-- zh_CN: 任务前泳道 —— 最左侧的中性泳道，放置任务开始前不属于任何智能体的提交 --%>
              <div
                id="agents-legend-pretask"
                class="flex items-center gap-2"
                data-tip={
                  gettext(
                    "The neutral leftmost lane holding commits no agent owns — they predate the task's agents."
                  )
                }
                phx-hook="LegendTooltip"
              >
                <span class="w-2.5 h-2.5 rounded-full bg-base-content/30 border border-base-content/40"></span>
                <span>{gettext("Pre-task lane")}</span>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Right Column: Agent Details Panel — full vertical space -->
      <div class="agents-detail-col">
        <div class="card bg-base-100 border border-base-300 rounded-lg">
          <div class="card-body p-4">
            <%= if @selected_agent_id do %>
              <% agent = Enum.find(@agents, &(&1.id == @selected_agent_id)) %>
              <%= if agent do %>
                <div id={"agent-detail-#{agent.id}"} class="agent-detail-content">
                  <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                    <div class="flex min-w-0 flex-wrap items-center gap-2">
                      <h3 class="card-title">
                        <.icon name="hero-identification" class="size-5" />
                        #{agent.task_local_id || agent.id}
                      </h3>
                      <div class={["badge badge-md", agent_status_bg(agent.status)]}>
                        <.icon
                          name={agent_status_icon(agent.status)}
                          class={"size-4 mr-1 #{agent_status_color(agent.status)}"}
                        />
                        <span class={agent_status_color(agent.status)}>{String.upcase(
                          agent_status_label(agent.status)
                        )}</span>
                      </div>
                    </div>
                    <div class="flex items-center gap-1">
                      <%= if agent.status in [:running, :waiting, :pending, :blocked] do %>
                        <button
                          class="btn btn-sm btn-ghost btn-circle tooltip"
                          data-tip={gettext("Send Message")}
                          phx-click="open_send_message"
                          phx-value-id={agent.id}
                        >
                          <.icon name="hero-chat-bubble-left-ellipsis" class="size-4" />
                        </button>
                      <% end %>
                      <button
                        class="btn btn-sm btn-ghost btn-circle"
                        phx-click="close_details"
                      >
                        <.icon name="hero-x-mark" class="size-4" />
                      </button>
                    </div>
                  </div>

                  <!-- Details -->
                  <div class="space-y-4">
                    <!-- Agent Module + Context Path on a single row -->
                    <div class="flex flex-wrap items-start gap-x-6 gap-y-3">
                      <div class="shrink-0 min-w-[130px]">
                        <h4 class="text-xs font-semibold uppercase text-base-content/70 mb-1">
                          {gettext("Agent Module")}
                        </h4>
                        <code class="text-xs bg-base-200/60 border border-base-300 px-2 py-1 rounded block break-all">
                          {inspect(agent.agent_module)}
                        </code>
                      </div>
                      <div class="shrink-0 min-w-[130px]">
                        <h4 class="text-xs font-semibold uppercase text-base-content/70 mb-1">
                          {gettext("Model")}
                        </h4>
                        <code class="text-xs bg-base-200/60 border border-base-300 px-2 py-1 rounded block break-all">
                          {agent.model_label || gettext("N/A")}
                        </code>
                      </div>
                      <div class="flex-1 min-w-[150px]">
                        <h4 class="text-xs font-semibold uppercase text-base-content/70 mb-1">
                          {gettext("Context Path")}
                        </h4>
                        <code class="text-xs bg-base-200/60 border border-base-300 px-2 py-1 rounded block break-all w-full">
                          {agent.context_path || gettext("N/A")}
                        </code>
                      </div>
                    </div>

                    <div>
                      <h4 class="text-xs font-semibold uppercase text-base-content/70 mb-1">
                        {gettext("Objective")}
                      </h4>
                      <p class="text-sm bg-base-200/50 border border-base-300 p-3 rounded">
                        {String.slice(agent.objective, 0, 150)}{if String.length(agent.objective) >
                                                                     150,
                                                                   do: "..."}
                        <%= if String.length(agent.objective) > 150 do %>
                          <button
                            class="btn btn-xs btn-ghost px-2 ml-2 text-base-content/70 hover:text-base-content"
                            phx-click="view_full_objective"
                            title={gettext("View Full Objective")}
                          >
                            <.icon name="hero-arrows-pointing-out" class="size-3" />
                          </button>
                        <% end %>
                      </p>
                    </div>

                    <div>
                      <h4 class="text-xs font-semibold uppercase text-base-content/70 mb-1">
                        {gettext("Worktree")}
                      </h4>
                      <code class="text-xs bg-base-200/60 border border-base-300 px-2 py-1 rounded block break-all">
                        {agent.worktree || gettext("Not assigned")}
                      </code>
                    </div>

                    <!-- Task ID, Depth, Retries (compact) + Base/Current Commit (wide) on a single row -->
                    <div class="flex flex-wrap items-start gap-x-6 gap-y-3">
                      <div class="shrink-0">
                        <h4 class="text-xs font-semibold uppercase text-base-content/70 mb-1">
                          {gettext("Task ID")}
                        </h4>
                        <span class="text-sm">#{agent.task_number || agent.task_id}</span>
                      </div>

                      <div class="shrink-0">
                        <h4 class="text-xs font-semibold uppercase text-base-content/70 mb-1">
                          {gettext("Depth")}
                        </h4>
                        <span class="text-sm">{agent.depth}</span>
                      </div>

                      <div class="shrink-0">
                        <h4 class="text-xs font-semibold uppercase text-base-content/70 mb-1">
                          {gettext("Retries")}
                        </h4>
                        <span class="text-sm">{agent.retries}</span>
                      </div>

                      <%= if agent.base_commit do %>
                        <div class="flex-1 min-w-0">
                          <h4 class="text-xs font-semibold uppercase text-base-content/70 mb-1">
                            <.icon name="hero-circle-stack" class="size-3 inline mr-1" /> {gettext(
                              "Base Commit"
                            )}
                          </h4>
                          <code
                            class="text-xs font-mono bg-base-200/60 border border-base-300 px-3 py-1.5 rounded block truncate w-full"
                            title={agent.base_commit}
                          >
                            {shorten_sha(agent.base_commit)}
                          </code>
                        </div>
                      <% end %>

                      <%= if agent.current_commit do %>
                        <div class="flex-1 min-w-0">
                          <h4 class="text-xs font-semibold uppercase text-base-content/70 mb-1">
                            <.icon name="hero-circle-stack" class="size-3 inline mr-1" /> {gettext(
                              "Current Commit"
                            )}
                          </h4>
                          <code
                            class={"text-xs font-mono px-3 py-1.5 rounded block truncate w-full " <> commit_bg_class(agent)}
                            title={agent.current_commit}
                          >
                            {shorten_sha(agent.current_commit)}
                          </code>
                        </div>
                      <% end %>
                    </div>

                    <div class="flex flex-col sm:flex-row gap-4">
                      <div class="shrink-0">
                        <h4 class="text-xs font-semibold uppercase text-base-content/70 mb-1">
                          {gettext("Parent")}
                        </h4>
                        <%= if agent.parent_id do %>
                          <button
                            class="btn btn-sm btn-ghost btn-xs"
                            phx-click="select_agent"
                            phx-value-id={agent.parent_id}
                          >
                            #{@id_to_display[agent.parent_id] || agent.parent_id}
                          </button>
                        <% else %>
                          <span class="text-sm text-base-content/70">{gettext("None")}</span>
                        <% end %>
                      </div>

                      <div class="flex-1 min-w-0">
                        <h4 class="text-xs font-semibold uppercase text-base-content/70 mb-1">
                          {gettext("Children")}
                        </h4>
                        <%= if agent.has_children do %>
                          <div class="flex flex-wrap gap-1">
                            <%= for {child_id, child_status} <- agent.children do %>
                              <button
                                class={[
                                  "badge badge-sm btn-xs cursor-pointer badge-outline",
                                  agent_status_border(child_status),
                                  agent_status_color(child_status)
                                ]}
                                phx-click="select_agent"
                                phx-value-id={child_id}
                              >
                                #{@id_to_display[child_id] || child_id}
                              </button>
                            <% end %>
                          </div>
                        <% else %>
                          <span class="text-sm text-base-content/70">{gettext("None")}</span>
                        <% end %>
                      </div>

                      <div class="shrink-0">
                        <h4 class="text-xs font-semibold uppercase text-base-content/70 mb-1">
                          &nbsp;
                        </h4>
                        <button
                          class="cursor-pointer text-xs font-semibold uppercase text-base-content/70 flex items-center gap-1.5 select-none outline-none hover:text-base-content transition-colors"
                          phx-click="toggle_usage"
                        >
                          <.icon name="hero-currency-dollar" class="size-3.5" />
                          {gettext("Token and Cost")}
                          <.icon
                            name="hero-chevron-down"
                            class={"size-3 opacity-50 transition-transform #{if @show_usage, do: "rotate-180"}"}
                          />
                        </button>
                      </div>
                    </div>
                  </div>

                  <%= if @show_usage do %>
                    <div class="mt-2">
                      <div class="grid grid-cols-3 gap-2 mt-2">
                        <div class="bg-base-200/50 border border-base-300 rounded-lg p-2.5">
                          <div class="text-xs text-base-content/70">
                            {gettext("Input Tokens")}
                          </div>
                          <div class="text-sm font-semibold">
                            {format_number(agent.usage.input_tokens)}
                          </div>
                        </div>
                        <div class="bg-base-200/50 border border-base-300 rounded-lg p-2.5">
                          <div class="text-xs text-base-content/70">
                            {gettext("Output Tokens")}
                          </div>
                          <div class="text-sm font-semibold">
                            {format_number(agent.usage.output_tokens)}
                          </div>
                        </div>
                        <div class="bg-base-200/50 border border-base-300 rounded-lg p-2.5">
                          <div class="text-xs text-base-content/70">
                            {gettext("Total Tokens")}
                          </div>
                          <div class="text-sm font-semibold">
                            {format_number(agent.usage.total_tokens)}
                          </div>
                        </div>
                      </div>
                      <div class="mt-4 pt-4 border-t border-base-300">
                        <div class="grid grid-cols-2 gap-2 mt-2">
                          <div class="bg-base-200/50 border border-base-300 rounded-lg p-2.5">
                            <div class="text-xs text-base-content/70">
                              {gettext("Cached Tokens")}
                            </div>
                            <div class="text-sm font-semibold">
                              {format_number(Map.get(agent.usage, :cached_tokens, 0))}
                            </div>
                          </div>
                          <div class="bg-base-200/50 border border-base-300 rounded-lg p-2.5">
                            <div class="text-xs text-base-content/70">
                              {gettext("Cache Hit Rate")}
                            </div>
                            <div class="text-sm font-semibold text-success">
                              {format_cache_hit_rate(agent.usage)}
                            </div>
                            <progress
                              class="progress progress-success w-full mt-1"
                              value={
                                if agent.usage.input_tokens > 0,
                                  do:
                                    min(
                                      round(
                                        Map.get(agent.usage, :cached_tokens, 0) /
                                          agent.usage.input_tokens * 100
                                      ),
                                      100
                                    ),
                                  else: 0
                              }
                              max="100"
                            ></progress>
                          </div>
                        </div>
                        <% meter = ContextMeter.build(agent) %>
                        <% context_label =
                          if meter.threshold_tokens,
                            do:
                              "#{format_number(meter.current_tokens)} / #{format_number(meter.threshold_tokens)}",
                            else: format_number(meter.current_tokens) %>
                        <% compression_label =
                          "#{meter.compression_count} (#{agent.compression_pct}%)" %>
                        <div class="mt-2 bg-base-200/50 border border-base-300 rounded-lg p-2.5">
                          <div class="flex items-baseline justify-between gap-2">
                            <div class="text-xs text-base-content/70">
                              {gettext("Context")}
                            </div>
                            <div class="text-xs font-semibold text-base-content/80">
                              {context_label}
                            </div>
                          </div>
                          <div
                            id="agent-context-meter"
                            class="relative mt-2"
                            data-context-fill-pct={meter.fill_label}
                            data-context-tick-pct={meter.tick_label}
                            data-context-zone={meter.zone}
                            data-context-window-tokens={meter.window_tokens}
                            data-context-threshold-tokens={meter.threshold_tokens}
                            data-context-current-tokens={meter.current_tokens}
                          >
                            <div class="h-1.5 w-full overflow-hidden rounded-full bg-base-300">
                              <div
                                class={["h-full rounded-full", meter.fill_class]}
                                style={"width: #{meter.fill_label}%"}
                              >
                              </div>
                            </div>
                            <%= if meter.tick_pct do %>
                              <div
                                class="absolute inset-y-0 w-2 -translate-x-1/2 cursor-default"
                                style={"left: #{meter.tick_label}%"}
                                title={
                                  gettext("Compression triggers at %{tokens} tokens",
                                    tokens: format_number(meter.threshold_tokens)
                                  )
                                }
                              >
                                <div class={[
                                  "absolute inset-y-0 left-1/2 w-0.5 -translate-x-1/2 rounded-full",
                                  meter.tick_class
                                ]}>
                                </div>
                                <div class={[
                                  "absolute -top-1 left-1/2 h-1.5 w-1.5 -translate-x-1/2 rotate-45 rounded-[1px]",
                                  meter.tick_class
                                ]}>
                                </div>
                              </div>
                            <% end %>
                          </div>
                          <div class="mt-1.5 flex items-center justify-between gap-2 text-xs text-base-content/70">
                            <span>
                              <%= if meter.tick_pct do %>
                                {gettext("Compression at %{tokens}",
                                  tokens: format_number(meter.threshold_tokens)
                                )}
                              <% else %>
                                {gettext("Compression threshold unknown")}
                              <% end %>
                            </span>
                            <% # zh_CN: 括号内的百分比 = 当前上下文占压缩阈值的比例 %>
                            <span class="whitespace-nowrap">
                              {gettext("Compressions")}: {compression_label}
                            </span>
                          </div>
                        </div>
                      </div>
                      <div class="mt-4 pt-4 border-t border-base-300">
                        <div class="grid grid-cols-3 gap-2 mt-2">
                          <div class="bg-base-200/50 border border-base-300 rounded-lg p-2.5">
                            <div class="text-xs text-base-content/70">
                              {gettext("Input Cost")}
                            </div>
                            <div class="text-sm font-semibold">
                              ${format_cost(agent.usage.input_cost)}
                            </div>
                          </div>
                          <div class="bg-base-200/50 border border-base-300 rounded-lg p-2.5">
                            <div class="text-xs text-base-content/70">
                              {gettext("Output Cost")}
                            </div>
                            <div class="text-sm font-semibold">
                              ${format_cost(agent.usage.output_cost)}
                            </div>
                          </div>
                          <div class="bg-base-200/50 border border-base-300 rounded-lg p-2.5">
                            <div class="text-xs text-base-content/70">
                              {gettext("Total Cost")}
                            </div>
                            <div class="text-sm font-semibold text-primary-standalone">
                              ${format_cost(agent.usage.total_cost)}
                            </div>
                          </div>
                        </div>
                        <.cost_estimate_notice />
                      </div>
                    </div>
                  <% end %>

                  <!-- Processes (managed OS executions of this agent) -->
                  {EvoDashWeb.AgentsLive.ProcessesSection.section(%{
                    agent_processes: @agent_processes,
                    current_node_id: @current_node_id,
                    selected_agent_id: @selected_agent_id
                  })}

                </div>
              <% else %>
                <p class="text-base-content">{gettext("Agent not found")}</p>
              <% end %>
            <% else %>
              <div class="text-center py-16">
                <.icon
                  name="hero-finger-pointing"
                  class="size-10 mx-auto mb-4 text-base-content/40"
                />
                <p class="text-lg text-base-content">
                  {gettext("Select an agent to view details")}
                </p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>


    <!-- Full Objective Modal -->
    <%= if @selected_objective do %>
      <div class="modal modal-open bg-black/50" id="full-objective-modal">
        <div class="modal-box w-11/12 max-w-5xl">
          <h3 class="font-bold text-lg mb-4 flex items-center gap-2">
            <.icon name="hero-document-text" class="size-5" />
            {gettext("Full Objective")}
          </h3>

          <div class="bg-base-200/50 border border-base-300 p-4 rounded-lg overflow-x-auto max-h-[70vh] overflow-y-auto">
            <pre class="text-sm whitespace-pre-wrap"><%= @selected_objective %></pre>
          </div>

          <div class="modal-action">
            <button class="btn" phx-click="close_objective_modal">{gettext("Close")}</button>
          </div>
        </div>

        <div class="modal-backdrop" phx-click="close_objective_modal">
          <button class="cursor-default">{gettext("close")}</button>
        </div>
      </div>
    <% end %>

    <!-- Send Message Modal -->
    <%= if @send_message_agent_id do %>
      <div class="modal modal-open bg-black/50" id="send-message-modal">
        <div class="modal-box w-11/12 max-w-2xl">
          <h3 class="font-bold text-lg mb-4 flex items-center gap-2">
            <.icon name="hero-chat-bubble-left-ellipsis" class="size-5" />
            {gettext("Send Message to Agent #%{id}",
              id: @id_to_display[@send_message_agent_id] || @send_message_agent_id
            )}
          </h3>

          <p class="text-sm text-base-content/60 mb-4">
            {gettext("Your message will be added to the agent's context on its next turn.")}
          </p>

          <form
            id={"send-message-form-" <> to_string(@send_message_agent_id)}
            phx-submit="send_agent_message"
            phx-change="validate_send_message"
          >
            <input type="hidden" name="agent_id" value={@send_message_agent_id} />
            <textarea
              class="textarea textarea-bordered w-full min-h-32"
              name="message"
              placeholder={gettext("Type your message here...")}
              autofocus
            ><%= @send_message_text %></textarea>

            <div class="modal-action">
              <button type="button" class="btn btn-ghost" phx-click="close_send_message">
                {gettext("Cancel")}
              </button>
              <button type="submit" class="btn btn-primary">
                <.icon name="hero-paper-airplane" class="size-4" />
                {gettext("Send")}
              </button>
            </div>
          </form>
        </div>

        <div class="modal-backdrop" phx-click="close_send_message">
          <button class="cursor-default">{gettext("close")}</button>
        </div>
      </div>
    <% end %>
  <% end %>
</EvoDashWeb.Layouts.app>
