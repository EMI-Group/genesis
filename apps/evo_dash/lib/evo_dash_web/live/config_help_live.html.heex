<EvoDashWeb.Layouts.app flash={@flash} current_page={:config_help}>
  <div class="space-y-6">
    <!-- Page Header -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold">Configuration Help & Settings</h1>
        <p class="text-base-content/60 mt-1">Manage your EvoGit configuration</p>
      </div>
    </div>

    <!-- Config Files Status Card -->
    <div class="card bg-base-200 shadow-sm">
      <div class="card-body">
        <h2 class="card-title text-lg">Config Files Status</h2>
        <div class="space-y-2 mt-2">
          <!-- config.toml status -->
          <div class="flex items-center gap-3">
            <%= if @config_status.config_exists do %>
              <.icon name="hero-check-circle" class="size-5 text-success" />
            <% else %>
              <.icon name="hero-x-circle" class="size-5 text-error" />
            <% end %>
            <code class="text-sm"><%= @config_status.config_path %></code>
          </div>
          <!-- credentials.toml status -->
          <div class="flex items-center gap-3">
            <%= if @config_status.credentials_exists do %>
              <.icon name="hero-check-circle" class="size-5 text-success" />
            <% else %>
              <.icon name="hero-x-circle" class="size-5 text-error" />
            <% end %>
            <code class="text-sm"><%= @config_status.credentials_path %></code>
          </div>
        </div>
        <%= if !@config_status.config_exists do %>
          <div class="mt-3 p-3 bg-warning/10 border border-warning rounded-lg">
            <p class="text-sm text-warning-content">Config file not found. You can create one using the editor below.</p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Validation Issues Card -->
    <div class="card bg-base-200 shadow-sm">
      <div class="card-body">
        <h2 class="card-title text-lg">
          Validation Issues
          <span class={"badge #{if length(@config_issues) > 0, do: "badge-warning", else: "badge-success"}"}><%= length(@config_issues) %></span>
        </h2>
        <%= if Enum.empty?(@config_issues) do %>
          <div class="alert alert-success mt-2">
            <.icon name="hero-check-circle" class="size-5" />
            <span>All config checks passed!</span>
          </div>
        <% else %>
          <div class="space-y-2 mt-2">
            <%= for issue <- @config_issues do %>
              <div class={"alert #{if issue.severity == :error, do: "alert-error", else: "alert-warning"}"}>
                <.icon name={if issue.severity == :error, do: "hero-exclamation-circle", else: "hero-exclamation-triangle"} class="size-5" />
                <div>
                  <span class="font-medium"><%= String.capitalize(to_string(issue.severity)) %>:</span>
                  <span><%= issue.message %></span>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- TOML Editor Card -->
    <div class="card bg-base-200 shadow-sm">
      <div class="card-body">
        <h2 class="card-title text-lg">Edit User Config</h2>
        <p class="text-sm text-base-content/60 mb-3">Edit your <code>config.toml</code> file directly. Changes are written to <%= @config_status.config_path %>.</p>
        <form phx-submit="save_config">
          <textarea name="config_content" class="textarea textarea-bordered w-full font-mono text-sm" rows="18" placeholder="TOML configuration..."><%= @config_content %></textarea>
          <div class="flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary">
              <.icon name="hero-check" class="size-4" />
              Save Config
            </button>
            <button type="button" class="btn btn-ghost" phx-click="validate_config">
              <.icon name="hero-arrow-path" class="size-4" />
              Validate
            </button>
            <button type="button" class="btn btn-ghost" phx-click="reset_template">
              <.icon name="hero-arrow-uturn-left" class="size-4" />
              Reset to Template
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Config Reference (Collapsible) -->
    <div class="collapse collapse-arrow bg-base-200">
      <input type="checkbox" checked={@show_reference} />
      <div class="collapse-title text-lg font-medium">
        Config Reference
      </div>
      <div class="collapse-content space-y-4">
        <div>
          <h3 class="font-semibold text-base">[scheduler]</h3>
          <p class="text-sm text-base-content/70 mb-1">Controls agent scheduling and concurrency.</p>
          <table class="table table-sm">
            <thead><tr><th>Field</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
            <tbody>
              <tr><td><code>max_concurrency</code></td><td>integer</td><td>3</td><td>Max concurrent LLM calls</td></tr>
              <tr><td><code>max_tool_concurrency</code></td><td>integer</td><td>2</td><td>Max concurrent tool executions</td></tr>
              <tr><td><code>agent_max_retries</code></td><td>integer</td><td>3</td><td>Max retries per agent on failure</td></tr>
              <tr><td><code>max_agent_depth</code></td><td>integer</td><td>8</td><td>Max nesting depth of subagents</td></tr>
              <tr><td><code>max_retries</code></td><td>integer</td><td>15</td><td>Max total retries across all agents</td></tr>
            </tbody>
          </table>
        </div>
        <div>
          <h3 class="font-semibold text-base">[llm]</h3>
          <p class="text-sm text-base-content/70 mb-1">LLM provider and model configuration.</p>
          <table class="table table-sm">
            <thead><tr><th>Field</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
            <tbody>
              <tr><td><code>model</code></td><td>string</td><td>(none)</td><td>Required. Model identifier (e.g., "zai_coding_plan:glm-5")</td></tr>
              <tr><td><code>compression_threshold_tokens</code></td><td>integer</td><td>100000</td><td>Token count above which conversation compression triggers</td></tr>
            </tbody>
          </table>
        </div>
        <div>
          <h3 class="font-semibold text-base">[user]</h3>
          <p class="text-sm text-base-content/70 mb-1">User identity settings.</p>
          <table class="table table-sm">
            <thead><tr><th>Field</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
            <tbody>
              <tr><td><code>github_username</code></td><td>string</td><td>(none)</td><td>GitHub username for commit co-authorship</td></tr>
            </tbody>
          </table>
        </div>
        <div>
          <h3 class="font-semibold text-base">[sandbox]</h3>
          <p class="text-sm text-base-content/70 mb-1">Sandbox execution settings for LLM-generated code.</p>
          <table class="table table-sm">
            <thead><tr><th>Field</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
            <tbody>
              <tr><td><code>mode</code></td><td>string</td><td>"auto"</td><td>Sandbox mode: "auto", "always", or "never"</td></tr>
            </tbody>
          </table>
        </div>
        <div>
          <h3 class="font-semibold text-base">[api_keys] (credentials.toml)</h3>
          <p class="text-sm text-base-content/70 mb-1">API keys are stored in a separate credentials file for security.</p>
          <table class="table table-sm">
            <thead><tr><th>Field</th><th>Description</th></tr></thead>
            <tbody>
              <tr><td><code>google</code></td><td>Google AI API key (for Gemini models)</td></tr>
              <tr><td><code>zai</code></td><td>ZAI API key</td></tr>
            </tbody>
          </table>
          <p class="text-sm text-base-content/60 mt-2">File location: <code><%= @config_status.credentials_path %></code> (same directory as config.toml)</p>
        </div>
      </div>
    </div>
  </div>
</EvoDashWeb.Layouts.app>
