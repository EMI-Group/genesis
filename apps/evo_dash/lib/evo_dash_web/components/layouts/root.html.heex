<!DOCTYPE html>
<html
  lang={Gettext.get_locale(EvoDashWeb.Gettext)}
  dir={if Gettext.get_locale(EvoDashWeb.Gettext) in ~w(ar he fa ur), do: "rtl", else: "ltr"}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="locale" content={Gettext.get_locale(EvoDashWeb.Gettext)} />
    <meta name="theme-color" content="#f8fafc" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <%!-- Brand name: Genesis (启元/啟元) --%>
    <meta name="apple-mobile-web-app-title" content={gettext("Genesis")} />
    <meta name="mobile-web-app-capable" content="yes" />
    <.live_title default={gettext("Genesis")} suffix={" · " <> gettext("Genesis")}>
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <link rel="icon" type="image/svg+xml" href={~p"/images/logo.svg"} id="favicon" />
    <link rel="apple-touch-icon" type="image/svg+xml" href={~p"/images/logo.svg"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>

    <script>
      (() => {
        const resolveSystemTheme = () =>
          window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        const updateThemeColor = (theme) => {
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.content = theme === "dark" ? "#020617" : "#f8fafc";
        };

        const updateFavicon = (theme) => {
          const favicon = document.getElementById("favicon");
          if (favicon) {
            favicon.href = theme === "dark" ? "/images/logo-alt.svg" : "/images/logo.svg";
          }
        };

        const applyTheme = (theme) => {
          const resolved = theme === "system" ? resolveSystemTheme() : theme;
          document.documentElement.setAttribute("data-theme", resolved);
          document.documentElement.setAttribute("data-theme-mode", resolved);
          updateThemeColor(resolved);
          updateFavicon(resolved);
        };

        // --- Art style（默认白天 / 默认黑夜 / 其他艺术风格，单选，不再独立明暗开关） ---
        const ART_STYLES = [
          "default", "default-dark", "constructivism", "swiss", "terminal", "ink",
          "bauhaus", "memphis", "brutalism", "glass", "neumorphism", "cyberpunk",
          "vaporwave", "nord", "gruvbox", "solarized-light", "solarized-dark",
          "mono", "blueprint", "kraft", "botanical", "noir", "pastel", "ocean",
          "desert", "artdeco"
        ];
        const setArt = (art) => {
          if (!ART_STYLES.includes(art)) art = "default";
          if (art === "default") {
            localStorage.removeItem("phx:art");
          } else {
            localStorage.setItem("phx:art", art);
          }
          document.documentElement.setAttribute("data-art", art);
          // 风格即主题：默认黑夜 → dark；其余一律 light（各艺术风格自带完整配色）
          applyTheme(art === "default-dark" ? "dark" : "light");
          // 标记切换器中的当前项
          document.querySelectorAll("[data-phx-art]").forEach(b =>
            b.classList.toggle("art-active", b.dataset.phxArt === art));
        };
        // 迁移旧的独立明暗偏好（一次性）
        if (!localStorage.getItem("phx:art") && localStorage.getItem("phx:theme")) {
          setArt(localStorage.getItem("phx:theme") === "dark" ? "default-dark" : "default");
        } else {
          setArt(localStorage.getItem("phx:art") || "default");
        }
        // ?art=<style> —— 链接级风格预览（同时写入偏好）
        const urlArt = new URLSearchParams(window.location.search).get("art");
        if (urlArt) setArt(urlArt);
        window.addEventListener("phx:set-art", (e) => setArt(e.target.dataset.phxArt || "default"));
        window.addEventListener("storage", (e) => {
          if (e.key === "phx:art") setArt(e.newValue || "default");
        });

        // --- Simple-mode theme（极简版独立主题：白天/黑夜/水墨/终端，只作用于 .simple-ui 页面） ---
        const SIMPLE_THEMES = ["day", "night", "ink", "terminal"];
        const setSimpleTheme = (t) => {
          if (!SIMPLE_THEMES.includes(t)) t = "day";
          if (t === "day") {
            localStorage.removeItem("phx:simple-theme");
          } else {
            localStorage.setItem("phx:simple-theme", t);
          }
          document.documentElement.setAttribute("data-simple-theme", t);
          document.querySelectorAll("[data-phx-simple-theme]").forEach(b =>
            b.classList.toggle("simple-theme-active", b.dataset.phxSimpleTheme === t));
        };
        setSimpleTheme(localStorage.getItem("phx:simple-theme") || "day");
        window.addEventListener("phx:set-simple-theme", (e) =>
          setSimpleTheme(e.target.dataset.phxSimpleTheme || "day"));
        window.addEventListener("storage", (e) => {
          if (e.key === "phx:simple-theme") setSimpleTheme(e.newValue || "day");
        });

        // --- 隔离：极简页（.simple-ui）不受专业版 data-art 艺术风格影响 ---
        // 艺术风格用 :root[data-art] 下的全局元素选择器（textarea/.btn/圆角重置等），
        // 会穿透 .simple-ui 的变量隔离。进入极简页时直接摘掉 data-art；
        // 回到专业版页面时按 localStorage 里的偏好恢复。
        const syncArtForSimplePages = () => {
          if (document.querySelector(".simple-ui")) {
            document.documentElement.removeAttribute("data-art");
          } else {
            setArt(localStorage.getItem("phx:art") || "default");
          }
        };
        document.addEventListener("DOMContentLoaded", syncArtForSimplePages);
        window.addEventListener("phx:page-loading-stop", syncArtForSimplePages);

        // --- Locale ---
        const rtlLocales = ['ar', 'he', 'fa', 'ur'];
        const setDirection = (locale) => {
          document.documentElement.dir = rtlLocales.includes(locale) ? 'rtl' : 'ltr';
        };

        const resolveLocale = () => {
          let locale = localStorage.getItem("phx:locale");
          if (!locale) {
            const meta = document.querySelector('meta[name="locale"]');
            locale = meta ? meta.content : "en";
          }
          if (!locale) locale = "en";
          localStorage.setItem("phx:locale", locale);
          document.cookie = "locale=" + locale + ";path=/;SameSite=Lax";
          setDirection(locale);
          return locale;
        };

        resolveLocale();

        window.addEventListener("phx:set-locale", (e) => {
          const locale = e.detail.locale;
          localStorage.setItem("phx:locale", locale);
          document.cookie = "locale=" + locale + ";path=/;SameSite=Lax";
          setDirection(locale);
          window.location.reload();
        });

        // Instant (no-reload) locale persistence — used by the welcome modal's
        // server-side language switcher. push_event/3 dispatches a window event
        // named `phx:<event>` verbatim, so the name must match exactly.
        window.addEventListener("phx:persist_locale", (e) => {
          const locale = e.detail.locale;
          localStorage.setItem("phx:locale", locale);
          document.cookie = "locale=" + locale + ";path=/;SameSite=Lax";
          setDirection(locale);
        });

        window.addEventListener("storage", (e) => {
          if (e.key === "phx:locale") {
            document.cookie = "locale=" + (e.newValue || "en") + ";path=/;SameSite=Lax";
            window.location.reload();
          }
        });
      })();
    </script>
  </head>

  <body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased h-screen overflow-hidden selection:bg-indigo-500/30">
    {@inner_content}
  </body>
</html>
