# The directory Mix will write compiled artifacts to.
/apps/*/build/
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
evo_git-*.tar

# Temporary files, for example, from tests.
/tmp/
/apps/evo_git/tmp

# Genesis runtime artifacts.
# Genesis creates isolated Git worktrees (one per agent) under this directory to
# carry out its work. These are transient build/scratch artifacts that must never
# be committed — they duplicate tracked sources and change on every run.
.genesis/

# Ignore local config files
*.local.exs

# Nix — flake.lock is committed, but result/ symlinks from nix build are not
/result
/result-*

# Vendor binaries (downloaded at build time, not committed)
/apps/evo_git/priv/vendor/*/git
/apps/evo_git/priv/vendor/*/rg
