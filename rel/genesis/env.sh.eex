#!/bin/sh

# Enable Erlang distribution for the genesis release when the user opts into
# SSH remote development. This is controlled by the GENESIS_REMOTE_DEV env var.
#
# When GENESIS_REMOTE_DEV=1, the local node enables EPMD-less distribution so it
# can connect to remote genesis_remote daemons over SSH tunnels. The distribution
# port is pinned to a configurable value (default 9000) for SSH port forwarding.
if [ "${GENESIS_REMOTE_DEV}" = "1" ]; then
  export RELEASE_DISTRIBUTION=name

  # Default node name can be overridden by GENESIS_NODE_NAME
  export RELEASE_NODE="${GENESIS_NODE_NAME:-genesis@127.0.0.1}"

  # The distribution cookie must match the remote daemon's cookie.
  # If not set, use the same default as genesis_remote.
  export RELEASE_COOKIE="${RELEASE_COOKIE:-genesis_remote_cookie}"
fi
