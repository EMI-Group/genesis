#!/bin/sh

# # Sets and enables heart (recommended only in daemon mode)
# case $RELEASE_COMMAND in
#   daemon*)
#     HEART_COMMAND="$RELEASE_ROOT/bin/$RELEASE_NAME $RELEASE_COMMAND"
#     export HEART_COMMAND
#     export ELIXIR_ERL_OPTIONS="-heart"
#     ;;
#   *)
#     ;;
# esac

# # Set the release to load code on demand (interactive) instead of preloading (embedded).
# export RELEASE_MODE=interactive

# # Set the release to work across nodes.
# # RELEASE_DISTRIBUTION must be "sname" (local), "name" (distributed) or "none".
# export RELEASE_DISTRIBUTION=name
# export RELEASE_NODE=<%= @release.name %>

# Remote-daemon distribution port pinning.
# A `genesis_server` release launched as the SSH remote-dev daemon is given
# GENESIS_REMOTE_DIST_PORT (default 9000), so the SSH tunnel can forward to a
# known port. The port is injected through ELIXIR_ERL_OPTIONS rather than a
# vm.args file entry: env.sh is sourced by the release launcher before it execs
# `elixir`, and the `elixir` launcher honours ELIXIR_ERL_OPTIONS. `genesis_server`
# deliberately declares NO inet_dist_listen_* range in vm.args.eex — a value in
# that file would take precedence and defeat this pin.
# Any pre-existing ELIXIR_ERL_OPTIONS value is preserved.
if [ -n "${GENESIS_REMOTE_DIST_PORT:-}" ]; then
  export ELIXIR_ERL_OPTIONS="-kernel inet_dist_listen_min ${GENESIS_REMOTE_DIST_PORT} inet_dist_listen_max ${GENESIS_REMOTE_DIST_PORT}${ELIXIR_ERL_OPTIONS:+ ${ELIXIR_ERL_OPTIONS}}"
fi
