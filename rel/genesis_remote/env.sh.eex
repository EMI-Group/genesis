#!/bin/sh

# Enable Erlang distribution for the remote daemon.
# This allows the local Genesis dashboard to connect via Node.connect/1.
# Uses EPMD-less distribution on a pinned port (set via vm.args).
export RELEASE_DISTRIBUTION=name
export RELEASE_NODE="${RELEASE_NODE:-genesis_remote@127.0.0.1}"

# The distribution cookie must match the local node's cookie for clustering.
# It is set by systemd-run/launchd during bootstrap.
# When not set, the BEAM uses its default (~/.erlang.cookie or random).
if [ -n "${RELEASE_COOKIE:-}" ]; then
  export RELEASE_COOKIE
fi

# Musl runtime library support: the musl build of genesis_remote bundles
# libgcc_s.so.1 in lib/runtime/ so that Rust NIFs (xqlite, mdex) load on
# minimal musl/Alpine systems where the libgcc package
# is not installed. The precompiled musl NIF .so files dynamically link
# against libgcc_s.so.1 (Rust's unwinding), and the musl ERTS itself also
# needs it. This LD_LIBRARY_PATH ensures the bundled copy is found first.
# The directory only exists in the musl tarball — glibc builds are unaffected.
if [ -d "${RELEASE_ROOT}/lib/runtime" ]; then
  export LD_LIBRARY_PATH="${RELEASE_ROOT}/lib/runtime${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
fi
