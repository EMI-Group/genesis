#!/bin/sh

# Enable Erlang distribution for the remote daemon.
# This allows the local Genesis dashboard to connect via Node.connect/1.
# Uses EPMD-less distribution on a pinned port (set via vm.args).
export RELEASE_DISTRIBUTION=name
export RELEASE_NODE="${RELEASE_NODE:-genesis_remote@127.0.0.1}"

# The distribution cookie must match the local node's cookie for clustering.
# It is set by systemd-run/launchd during bootstrap.
# When not set, the BEAM uses its default (~/.erlang.cookie or random).
if [ -n "${RELEASE_COOKIE:-}" ]; then
  export RELEASE_COOKIE
fi
