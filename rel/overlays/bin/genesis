#!/bin/sh
# Genesis server CLI — manages the Genesis server release this script lives in.
#
# This file is a release overlay (`rel/overlays/bin/genesis`) copied into
# `<release>/bin/` by Mix. Lifecycle commands deliberately avoid booting the
# BEAM: they talk to systemd/launchd (or a pidfile) and probe the dashboard's
# `/health` endpoint, so `genesis status` stays fast and still works when the
# server itself cannot boot.
set -eu

DEFAULT_IP=127.0.0.1
DEFAULT_PORT=9999
SYSTEMD_UNIT=genesis-server
# Reverse-DNS label for the launchd LaunchAgent written by `start` on macOS.
LAUNCHD_LABEL=com.genesis.server
PROBE_TIMEOUT=3
START_TIMEOUT=30

FLAG_IP=""
FLAG_PORT=""
FLAG_HOST=""
FLAG_FOREGROUND=0
FLAG_NO_LINGER=0

die() {
  printf 'genesis: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: genesis [command] [options]

A headless Genesis server: the dashboard served over HTTP, no desktop shell.

Commands:
  serve, run            Run the server in the foreground (the default)
  start                 Start the server as a background service
  stop                  Stop the background service
  restart               Stop, then start (reusing the last ip/port)
  status                Show service state and probe /health
  update                Update the server to the latest release (see below)
  upgrade               Alias for `update`
  logs [-f]             Show recent logs (-f follows)
  url                   Print the dashboard URL
  version               Print the release version
  remote <command>      Toggle SSH remote development on the server instance
                        (start|stop|status|logs; see `genesis remote help`)
  help, -h, --help      Show this help

Options (serve/start/restart/status/url):
  --ip ADDR             Bind address (default 127.0.0.1)
  --port N              HTTP port (default 9999)
  --host NAME           Optional external hostname for generated URLs (PHX_HOST)
  --no-linger           Do not offer to enable systemd lingering (start)

Options (update/upgrade):
  --check               Only check for a newer release (exit 10 when there is
                        one); nothing is downloaded, installed or stopped
  --json                With --check, print one line of JSON:
                        {"current":"<v>","latest":"<v>","available":true|false}
  --version TAG         Install a specific release tag (v0.13.0 or 0.13.0);
                        default: the latest release
  --force               Reinstall even when up to date, and bypass the
                        active-task / foreground-server safety guard
  --wait N              Seconds to wait for /health after the restart (30)
  -h, --help            Show the update help (`genesis update --help`)

Both `--flag value` and `--flag=value` are accepted; `start -f` (or
`--foreground`) behaves like `serve`.

Environment:
  GENESIS_HOME          Release root (default: the parent of this script's dir)
  GENESIS_DATA_DIR      State and log directory override
  GENESIS_LINGER        Linger policy for start: ask|yes|no (default ask)
  GENESIS_DOWNLOAD_BASE           Release feed base for update
                                  (default https://genesis.evox.group/dl)
  GENESIS_DOWNLOAD_FALLBACK_BASE  Fallback feed base for update (default the
                                  GitHub releases page)

Exit codes: 0 = success (or already up to date), 10 = update available
(`update --check` only), 1 = failure, 2 = usage error.

Erlang distribution for SSH remote development is a RUNTIME TOGGLE on the ONE
server instance: `remote start` starts it first when it is not running, then
enables distribution, and `remote stop` detaches distribution again. Neither
ever runs a second process. See `genesis remote help`.
EOF
}

# ── Release discovery ────────────────────────────────────────────────────────

# Resolve $0 through symlinks without `readlink -f`, which macOS/BSD readlink
# does not support. Copies of these scripts are installed as `~/.local/bin`
# symlinks, so the release root must be found from the real file.
resolve_self() {
  _target=$1

  # Invoked through PATH (no slash): locate the actual file first.
  case $_target in
    */*) ;;
    *)
      _found=$(command -v "$_target" 2>/dev/null || true)
      if [ -n "$_found" ]; then _target=$_found; fi
      ;;
  esac

  # Bound the hop count so a symlink cycle cannot spin forever.
  _hops=0
  while [ -L "$_target" ] && [ "$_hops" -lt 40 ]; do
    _dir=$(cd -P "$(dirname "$_target")" && pwd)
    _link=$(readlink "$_target")
    case $_link in
      /*) _target=$_link ;;
      *) _target=$_dir/$_link ;;
    esac
    _hops=$((_hops + 1))
  done

  _dir=$(cd -P "$(dirname "$_target")" && pwd)
  printf '%s/%s\n' "$_dir" "$(basename "$_target")"
}

if [ -z "${GENESIS_HOME:-}" ]; then
  _self=$(resolve_self "$0")
  _self_dir=$(dirname "$_self")
  # <release>/bin/genesis → the release root is the parent of bin/.
  if [ "$(basename "$_self_dir")" = bin ]; then
    GENESIS_HOME=$(dirname "$_self_dir")
  else
    GENESIS_HOME=$_self_dir
  fi
fi

# Trim a trailing slash (but never turn "/" into an empty string).
case $GENESIS_HOME in
  */) [ "$GENESIS_HOME" = / ] || GENESIS_HOME=${GENESIS_HOME%/} ;;
esac
export GENESIS_HOME

LAUNCHER=$GENESIS_HOME/bin/genesis_server

require_launcher() {
  if [ ! -x "$LAUNCHER" ]; then
    die "not inside a Genesis server release ($LAUNCHER is missing); set GENESIS_HOME=<release root>"
  fi
}

# ── Data dir, state file and log file ────────────────────────────────────────

# Mirror EvoGit.Platform.data_dir/0: GENESIS_DATA_DIR wins, then the platform
# default (XDG on Linux, Application Support on macOS).
data_dir() {
  if [ -n "${GENESIS_DATA_DIR:-}" ]; then
    _dir=$GENESIS_DATA_DIR
    case $_dir in
      */) [ "$_dir" = / ] || _dir=${_dir%/} ;;
    esac
    printf '%s\n' "$_dir"
    return 0
  fi

  case $(uname -s 2>/dev/null || printf 'unknown') in
    Darwin)
      printf '%s/Library/Application Support/genesis\n' "${HOME:-/tmp}"
      ;;
    *)
      if [ -n "${XDG_DATA_HOME:-}" ]; then
        _xdg=$XDG_DATA_HOME
        case $_xdg in
          */) [ "$_xdg" = / ] || _xdg=${_xdg%/} ;;
        esac
        printf '%s/genesis\n' "$_xdg"
      else
        printf '%s/.local/share/genesis\n' "${HOME:-/tmp}"
      fi
      ;;
  esac
}

state_file() { printf '%s/server.env\n' "$(data_dir)"; }
pid_file() { printf '%s/server.pid\n' "$(data_dir)"; }
server_log_file() { printf '%s/server.log\n' "$(data_dir)"; }

# Read KEY from the state file (empty when unset). The file is parsed rather
# than sourced so a stray line can never execute code.
state_get() {
  _file=$(state_file)
  if [ -f "$_file" ]; then
    sed -n "s/^$1=//p" "$_file" | tail -n 1
  fi
  return 0
}

state_save() {
  _dir=$(data_dir)
  mkdir -p "$_dir"
  _tmp="$_dir/server.env.tmp.$$"
  {
    printf 'GENESIS_IP=%s\n' "$1"
    printf 'GENESIS_PORT=%s\n' "$2"
  } >"$_tmp"
  mv -f "$_tmp" "$_dir/server.env"
}

effective_ip() {
  if [ -n "$FLAG_IP" ]; then
    printf '%s\n' "$FLAG_IP"
    return 0
  fi
  _saved=$(state_get GENESIS_IP)
  if [ -n "$_saved" ]; then
    printf '%s\n' "$_saved"
  else
    printf '%s\n' "$DEFAULT_IP"
  fi
}

effective_port() {
  if [ -n "$FLAG_PORT" ]; then
    printf '%s\n' "$FLAG_PORT"
    return 0
  fi
  _saved=$(state_get GENESIS_PORT)
  if [ -n "$_saved" ]; then
    printf '%s\n' "$_saved"
  else
    printf '%s\n' "$DEFAULT_PORT"
  fi
}

# ── URLs and the health probe ────────────────────────────────────────────────

# Display host for a URL: a wildcard bind is only reachable via loopback for
# the local user, and IPv6 literals must be bracketed inside URLs.
url_host() {
  case $1 in
    0.0.0.0 | :: | '') printf '127.0.0.1' ;;
    *:*) printf '[%s]' "$1" ;;
    *) printf '%s' "$1" ;;
  esac
}

dashboard_url() {
  printf 'http://%s:%s\n' "$(url_host "$1")" "$2"
}

probe_tool() {
  if command -v curl >/dev/null 2>&1; then
    printf 'curl\n'
  elif command -v wget >/dev/null 2>&1; then
    printf 'wget\n'
  else
    printf 'none\n'
  fi
}

# HTTP health probe against <url>/health.
#   0 = HTTP 2xx, 1 = unreachable/error status, 2 = no curl and no wget.
# Variables are namespaced: POSIX sh has no `local`, so a shared name would
# leak back into the caller (e.g. the printed URL).
probe_health() {
  _probe_url=$1/health
  case $(probe_tool) in
    curl)
      if curl -fsS -m "$PROBE_TIMEOUT" -o /dev/null "$_probe_url" >/dev/null 2>&1; then
        return 0
      fi
      ;;
    wget)
      if wget -qO- -T "$PROBE_TIMEOUT" "$_probe_url" >/dev/null 2>&1; then
        return 0
      fi
      ;;
    *)
      return 2
      ;;
  esac
  return 1
}

# Poll until healthy. 0 = healthy, 1 = timed out, 2 = cannot probe.
wait_for_health() {
  _wait_url=$1
  _wait_n=0
  while [ "$_wait_n" -lt "$START_TIMEOUT" ]; do
    _wait_rc=0
    probe_health "$_wait_url" >/dev/null 2>&1 || _wait_rc=$?
    if [ "$_wait_rc" -eq 0 ]; then return 0; fi
    if [ "$_wait_rc" -eq 2 ]; then return 2; fi
    _wait_n=$((_wait_n + 1))
    sleep 1
  done
  return 1
}

# ── Flag parsing ─────────────────────────────────────────────────────────────

validate_port() {
  case $1 in
    '' | *[!0-9]*) die "invalid port: $1" ;;
  esac
  if [ "$1" -lt 1 ] || [ "$1" -gt 65535 ]; then
    die "port out of range (1-65535): $1"
  fi
}

# Accept both `--flag value` and `--flag=value`.
parse_flags() {
  FLAG_IP=""
  FLAG_PORT=""
  FLAG_HOST=""
  FLAG_FOREGROUND=0
  FLAG_NO_LINGER=0

  while [ $# -gt 0 ]; do
    case $1 in
      --ip=*)
        FLAG_IP=${1#--ip=}
        [ -n "$FLAG_IP" ] || die "--ip requires a value"
        shift
        ;;
      --ip)
        [ $# -ge 2 ] || die "--ip requires a value"
        [ -n "$2" ] || die "--ip requires a value"
        FLAG_IP=$2
        shift 2
        ;;
      --port=*)
        FLAG_PORT=${1#--port=}
        [ -n "$FLAG_PORT" ] || die "--port requires a value"
        shift
        ;;
      --port)
        [ $# -ge 2 ] || die "--port requires a value"
        [ -n "$2" ] || die "--port requires a value"
        FLAG_PORT=$2
        shift 2
        ;;
      --host=*)
        FLAG_HOST=${1#--host=}
        [ -n "$FLAG_HOST" ] || die "--host requires a value"
        shift
        ;;
      --host)
        [ $# -ge 2 ] || die "--host requires a value"
        [ -n "$2" ] || die "--host requires a value"
        FLAG_HOST=$2
        shift 2
        ;;
      --foreground | -f)
        FLAG_FOREGROUND=1
        shift
        ;;
      --no-linger)
        FLAG_NO_LINGER=1
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      --)
        shift
        break
        ;;
      *)
        usage >&2
        die "unknown option: $1"
        ;;
    esac
  done

  if [ -n "$FLAG_PORT" ]; then
    validate_port "$FLAG_PORT"
  fi
}

# ── Service backends ─────────────────────────────────────────────────────────

is_linux() { [ "$(uname -s 2>/dev/null || printf 'unknown')" = Linux ]; }
is_darwin() { [ "$(uname -s 2>/dev/null || printf 'unknown')" = Darwin ]; }

# `systemd-run --user` needs a reachable user systemd instance. The binaries
# exist inside containers without one (where every start fails), so the real
# signal is a successful `systemctl --user` round-trip plus $XDG_RUNTIME_DIR.
systemd_usable() {
  is_linux || return 1
  command -v systemd-run >/dev/null 2>&1 || return 1
  command -v systemctl >/dev/null 2>&1 || return 1
  if [ -z "${XDG_RUNTIME_DIR:-}" ] || [ ! -d "$XDG_RUNTIME_DIR" ]; then
    return 1
  fi
  if command -v timeout >/dev/null 2>&1; then
    timeout 5 systemctl --user show-environment >/dev/null 2>&1 || return 1
  else
    systemctl --user show-environment >/dev/null 2>&1 || return 1
  fi
  return 0
}

launchd_usable() {
  is_darwin || return 1
  command -v launchctl >/dev/null 2>&1 || return 1
  return 0
}

# Which supervisor manages the server on this host.
service_backend() {
  if systemd_usable; then
    printf 'systemd\n'
  elif launchd_usable; then
    printf 'launchd\n'
  else
    printf 'fallback\n'
  fi
}

launchd_plist() {
  printf '%s/Library/LaunchAgents/%s.plist\n' "${HOME:-/tmp}" "$LAUNCHD_LABEL"
}

launchd_domain() { printf 'gui/%s\n' "$(id -u)"; }

launchd_loaded() {
  launchctl print "$(launchd_domain)/$LAUNCHD_LABEL" >/dev/null 2>&1
}

pidfile_active() {
  _pidf=$(pid_file)
  if [ ! -f "$_pidf" ]; then return 1; fi
  _pid=$(sed -n '1p' "$_pidf" | tr -d '[:space:]')
  if [ -z "$_pid" ]; then return 1; fi
  case $_pid in
    *[!0-9]*) return 1 ;;
  esac
  kill -0 "$_pid" 2>/dev/null
}

service_active() {
  case $(service_backend) in
    systemd) systemctl --user is-active --quiet "$SYSTEMD_UNIT" >/dev/null 2>&1 ;;
    launchd) launchd_loaded ;;
    *) pidfile_active ;;
  esac
}

# Main pid of the ONE server instance this host runs (empty when it is not
# running). This is the process `genesis remote` signals: remote development is
# a runtime toggle on the instance, never a second process.
instance_pid() {
  case $(service_backend) in
    systemd)
      _inst_pid=$(systemctl --user show "$SYSTEMD_UNIT" -p MainPID --value 2>/dev/null || true)
      _inst_pid=$(printf '%s\n' "$_inst_pid" | tr -d '[:space:]')
      # An inactive unit answers 0, or nothing at all.
      case $_inst_pid in
        '' | *[!0-9]*) return 0 ;;
        0) return 0 ;;
      esac
      printf '%s\n' "$_inst_pid"
      ;;
    launchd)
      _inst_raw=$(launchctl list "$LAUNCHD_LABEL" 2>/dev/null || true)
      # Dictionary form: `"PID" = 1234;`
      _inst_pid=$(printf '%s\n' "$_inst_raw" |
        sed -n 's/.*"PID"[[:space:]]*=[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -n 1)
      if [ -z "$_inst_pid" ]; then
        # Table form (pid, status, label): the pid of this label's own line.
        _inst_pid=$(printf '%s\n' "$_inst_raw" |
          awk -v label="$LAUNCHD_LABEL" '$3 == label && $1 ~ /^[0-9]+$/ { print $1; exit }')
      fi
      [ -n "$_inst_pid" ] || return 0
      printf '%s\n' "$_inst_pid"
      ;;
    *)
      _inst_pid=$(sed -n '1p' "$(pid_file)" 2>/dev/null | tr -d '[:space:]' || true)
      case $_inst_pid in
        '' | *[!0-9]*) return 0 ;;
      esac
      if kill -0 "$_inst_pid" 2>/dev/null; then printf '%s\n' "$_inst_pid"; fi
      ;;
  esac
  return 0
}

instance_running() {
  _running_pid=$(instance_pid)
  [ -n "$_running_pid" ]
}

# ── systemd lingering ────────────────────────────────────────────────────────

# Without lingering, systemd tears a `--user` unit down when the user's last
# session ends — so the server would stop on logout. These helpers only ever
# warn: a refusal or a failure must never change `start`'s exit status.

# The current user name for `loginctl`; empty when it cannot be resolved.
linger_user() {
  _linger_id=$(id -un 2>/dev/null || true)
  if [ -z "$_linger_id" ]; then
    _linger_id=${USER:-}
  fi
  printf '%s' "$_linger_id"
}

# Prints exactly one of `enabled` / `disabled` / `unknown`.
# `loginctl show-user` is used in its full-property form (`Linger=yes|no`)
# because older loginctl builds have no `--value`; when it is missing or its
# output is unusable, the linger marker file is consulted instead. An absent
# marker is `unknown`, NOT `disabled`: it proves nothing about older hosts.
linger_state() {
  _linger_state_user=$(linger_user)
  if [ -z "$_linger_state_user" ]; then
    printf 'unknown\n'
    return 0
  fi

  if command -v loginctl >/dev/null 2>&1; then
    _linger_state_out=$(loginctl show-user "$_linger_state_user" 2>/dev/null || true)
    case $_linger_state_out in
      *Linger=yes*)
        printf 'enabled\n'
        return 0
        ;;
      *Linger=no*)
        printf 'disabled\n'
        return 0
        ;;
    esac
  fi

  if [ -e "/var/lib/systemd/linger/$_linger_state_user" ]; then
    printf 'enabled\n'
  else
    printf 'unknown\n'
  fi
  return 0
}

linger_hint() {
  printf 'Warning: systemd lingering is disabled, so systemd stops Genesis when you log out.\n' >&2
  printf 'Enable it with: loginctl enable-linger %s\n' "$1" >&2
  printf 'If polkit requires authentication, use: sudo loginctl enable-linger %s\n' "$1" >&2
}

linger_enable_failed() {
  printf 'Warning: could not enable systemd lingering; the server stops when you log out.\n' >&2
  printf 'Run it manually: loginctl enable-linger %s\n' "$1" >&2
  printf 'or with sudo: sudo loginctl enable-linger %s\n' "$1" >&2
}

linger_still_disabled() {
  printf 'Warning: systemd lingering still reports disabled; the server may stop when you log out.\n' >&2
  printf 'Run it manually: sudo loginctl enable-linger %s\n' "$1" >&2
}

# Offer (or, under GENESIS_LINGER=yes, perform) `loginctl enable-linger` for the
# systemd backend. Other backends have no session-teardown problem, so they are
# left untouched. Always returns 0 and never prompts when stdin is not a TTY.
# Variables are namespaced: POSIX sh has no `local`.
ensure_linger() {
  if [ "$1" != systemd ]; then return 0; fi

  _linger_policy=$(printf '%s' "${GENESIS_LINGER:-ask}" | tr 'A-Z' 'a-z')
  case $_linger_policy in
    no | skip) return 0 ;;
    yes | enable) ;;
    *) _linger_policy=ask ;;
  esac
  if [ "$FLAG_NO_LINGER" = 1 ]; then return 0; fi

  _linger_cur_user=$(linger_user)
  if [ -z "$_linger_cur_user" ]; then
    # No user → the state is `unknown`, which needs no warning.
    return 0
  fi

  if [ "$(linger_state)" != disabled ]; then
    return 0
  fi

  if [ "$_linger_policy" = ask ]; then
    if [ -t 0 ]; then
      printf 'Genesis runs as a systemd user service. Unless lingering is enabled, systemd stops it when you log out.\n' >&2
      printf "Enable systemd lingering for '%s' now? [Y/n] " "$_linger_cur_user" >&2
      # One line only, and never abort under `set -eu` on EOF.
      _linger_answer=""
      IFS= read -r _linger_answer || _linger_answer=""
      case $_linger_answer in
        '' | y | Y | yes | YES) ;;
        *)
          linger_hint "$_linger_cur_user"
          return 0
          ;;
      esac
    else
      # Non-interactive (script, CI, container): never block on a prompt.
      linger_hint "$_linger_cur_user"
      return 0
    fi
  fi

  if ! command -v loginctl >/dev/null 2>&1; then
    linger_enable_failed "$_linger_cur_user"
    return 0
  fi
  if ! loginctl enable-linger "$_linger_cur_user"; then
    linger_enable_failed "$_linger_cur_user"
    return 0
  fi

  printf "Enabled systemd lingering for '%s'; the server keeps running after you log out.\n" "$_linger_cur_user"
  # A single re-probe (no retry loop): polkit may have accepted the call while
  # lingering is still off.
  if [ "$(linger_state)" != enabled ]; then
    linger_still_disabled "$_linger_cur_user"
  fi
  return 0
}

# ── Starting and stopping ────────────────────────────────────────────────────

start_systemd() {
  _ip=$1
  _port=$2
  _host=$3

  # Reset first: a previously failed transient unit can linger and block re-use
  # of the unit name even with --collect (which only collects clean exits on
  # older systemd versions). Idempotent when there is nothing to reset.
  systemctl --user reset-failed "$SYSTEMD_UNIT" >/dev/null 2>&1 || true

  # --collect makes systemd garbage-collect the transient unit once the process
  # exits, so `stop` leaves nothing behind and the name is free for `start`.
  # Restart=on-failure keeps a crashed server alive without operator action.
  # The environment is accumulated through the positional parameters (POSIX sh
  # has no arrays), so no value is ever re-split by the shell. An explicitly set
  # GENESIS_DATA_DIR is passed along: the instance must read and write the same
  # <data dir>/remote/ control state this CLI does.
  set -- --setenv=PHX_IP="$_ip" --setenv=PORT="$_port"
  if [ -n "$_host" ]; then set -- "$@" --setenv=PHX_HOST="$_host"; fi
  if [ -n "${GENESIS_DATA_DIR:-}" ]; then
    set -- "$@" "--setenv=GENESIS_DATA_DIR=$(data_dir)"
  fi

  if ! systemd-run --user --unit="$SYSTEMD_UNIT" --collect \
    --property=Restart=on-failure --property=RestartSec=5 \
    "$@" "$LAUNCHER" start; then
    die "systemd-run failed to start $SYSTEMD_UNIT"
  fi
  return 0
}

xml_escape() {
  printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

write_launchd_plist() {
  _ip=$1
  _port=$2
  _host=$3

  _plist=$(launchd_plist)
  mkdir -p "$(dirname "$_plist")"
  _log=$(server_log_file)
  mkdir -p "$(dirname "$_log")"

  _host_env=""
  if [ -n "$_host" ]; then
    _host_env="    <key>PHX_HOST</key><string>$(xml_escape "$_host")</string>"
  fi

  # Same reasoning as the systemd unit: an explicitly set data dir must reach
  # the instance, or it would publish its control state somewhere else.
  _data_env=""
  if [ -n "${GENESIS_DATA_DIR:-}" ]; then
    _data_env="    <key>GENESIS_DATA_DIR</key><string>$(xml_escape "$(data_dir)")</string>"
  fi

  cat >"$_plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LAUNCHD_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$(xml_escape "$LAUNCHER")</string>
    <string>start</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PHX_IP</key><string>$(xml_escape "$_ip")</string>
    <key>PORT</key><string>$_port</string>
$_host_env
$_data_env
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$(xml_escape "$_log")</string>
  <key>StandardErrorPath</key><string>$(xml_escape "$_log")</string>
</dict>
</plist>
EOF
}

start_launchd() {
  _ip=$1
  _port=$2
  _host=$3

  # bootstrap fails while the label is loaded; bootout first so `start` stays
  # idempotent and picks up refreshed ip/port values.
  if launchd_loaded; then
    launchctl bootout "$(launchd_domain)/$LAUNCHD_LABEL" >/dev/null 2>&1 || true
  fi

  write_launchd_plist "$_ip" "$_port" "$_host"

  if ! launchctl bootstrap "$(launchd_domain)" "$(launchd_plist)"; then
    die "launchctl bootstrap failed for $LAUNCHD_LABEL"
  fi
  return 0
}

# Last-resort daemonization for hosts with neither systemd user units nor
# launchd (containers, minimal distros): detach with setsid/nohup and track the
# pid so `stop`/`status` still work.
start_fallback() {
  _ip=$1
  _port=$2
  _host=$3

  _dir=$(data_dir)
  mkdir -p "$_dir"
  _log="$_dir/server.log"
  _pidfile="$_dir/server.pid"

  PHX_IP=$_ip
  PORT=$_port
  export PHX_IP PORT
  if [ -n "$_host" ]; then
    PHX_HOST=$_host
    export PHX_HOST
  fi

  # setsid detaches from the controlling terminal; macOS has no setsid, so fall
  # back to nohup, which is enough to survive the parent shell exiting.
  if command -v setsid >/dev/null 2>&1; then
    setsid "$LAUNCHER" start >>"$_log" 2>&1 </dev/null &
  else
    nohup "$LAUNCHER" start >>"$_log" 2>&1 </dev/null &
  fi
  printf '%s\n' "$!" >"$_pidfile"
}

do_start() {
  _ip=$1
  _port=$2
  _host=$3

  case $(service_backend) in
    systemd) start_systemd "$_ip" "$_port" "$_host" ;;
    launchd) start_launchd "$_ip" "$_port" "$_host" ;;
    *) start_fallback "$_ip" "$_port" "$_host" ;;
  esac
}

# 0 when something was stopped, 1 when nothing was running.
do_stop() {
  case $(service_backend) in
    systemd)
      if ! systemctl --user is-active --quiet "$SYSTEMD_UNIT" >/dev/null 2>&1; then
        systemctl --user reset-failed "$SYSTEMD_UNIT" >/dev/null 2>&1 || true
        return 1
      fi
      if ! systemctl --user stop "$SYSTEMD_UNIT"; then
        die "systemctl --user stop $SYSTEMD_UNIT failed"
      fi
      # Clear the unit state so a later start does not inherit "failed".
      systemctl --user reset-failed "$SYSTEMD_UNIT" >/dev/null 2>&1 || true
      return 0
      ;;
    launchd)
      if ! launchd_loaded; then return 1; fi
      if ! launchctl bootout "$(launchd_domain)/$LAUNCHD_LABEL" >/dev/null 2>&1; then
        die "launchctl bootout failed for $LAUNCHD_LABEL"
      fi
      return 0
      ;;
    *)
      if ! pidfile_active; then
        rm -f "$(pid_file)"
        return 1
      fi
      _pid=$(sed -n '1p' "$(pid_file)" | tr -d '[:space:]')
      # TERM first: the VM shuts down cleanly and flushes its SQLite WAL.
      kill -TERM "$_pid" 2>/dev/null || true
      _i=0
      while [ "$_i" -lt 10 ]; do
        kill -0 "$_pid" 2>/dev/null || break
        sleep 1
        _i=$((_i + 1))
      done
      rm -f "$(pid_file)"
      return 0
      ;;
  esac
}

# Start the instance and wait for /health — the shared start sequence of
# `genesis start` and `genesis remote start` (remote development is a toggle on
# the instance, so a fresh host has to bring it up first). Prints the same lines
# `genesis start` always has. 0 = usable, 1 = it did not come up.
start_and_wait() {
  _saw_ip=$1
  _saw_port=$2
  _saw_host=$3
  _saw_url=$(dashboard_url "$_saw_ip" "$_saw_port")

  state_save "$_saw_ip" "$_saw_port"

  _saw_backend=$(service_backend)
  ensure_linger "$_saw_backend"
  do_start "$_saw_ip" "$_saw_port" "$_saw_host"
  printf 'Genesis server starting (%s backend).\n' "$_saw_backend"
  printf 'Dashboard: %s\n' "$_saw_url"

  _saw_rc=0
  wait_for_health "$_saw_url" || _saw_rc=$?
  case $_saw_rc in
    0)
      printf 'Genesis server is healthy: %s\n' "$_saw_url"
      ;;
    2)
      printf 'Cannot verify health: neither curl nor wget is installed.\n'
      ;;
    *)
      printf 'Genesis server did not become healthy within %ss: %s\n' "$START_TIMEOUT" "$_saw_url" >&2
      printf 'Recent logs:\n' >&2
      print_logs_tail 20 >&2
      return 1
      ;;
  esac
  return 0
}

# ── Logs ─────────────────────────────────────────────────────────────────────

# launchd writes to the plist's StandardOutPath; everything else uses
# <data_dir>/server.log (systemd captures stdout in the journal instead).
log_file() {
  if [ "$(service_backend)" = launchd ]; then
    _plist=$(launchd_plist)
    if [ -f "$_plist" ]; then
      _out=$(sed -n 's:.*<key>StandardOutPath</key><string>\(.*\)</string>.*:\1:p' "$_plist" | head -n 1)
      if [ -n "$_out" ]; then
        printf '%s\n' "$_out"
        return 0
      fi
    fi
  fi
  server_log_file
}

# Print the tail of the log through the same source `logs` uses (used to
# explain a failed start).
print_logs_tail() {
  _tail_lines=${1:-20}
  if [ "$(service_backend)" = systemd ] && command -v journalctl >/dev/null 2>&1; then
    journalctl --user -u "$SYSTEMD_UNIT" -n "$_tail_lines" 2>/dev/null || true
    return 0
  fi
  _tail_log=$(log_file)
  if [ -f "$_tail_log" ]; then
    tail -n "$_tail_lines" "$_tail_log" || true
  else
    printf 'No server log at %s yet.\n' "$_tail_log"
  fi
}

# Print (or follow) the INSTANCE's logs through the source its backend keeps
# them in: the user journal on systemd, the plist's StandardOutPath on launchd,
# else <data_dir>/server.log. Shared by `genesis logs` and `genesis remote logs`
# (one instance, one log).
show_instance_logs() {
  _sil_follow=$1
  _sil_lines=$2

  if [ "$(service_backend)" = systemd ] && command -v journalctl >/dev/null 2>&1; then
    if [ "$_sil_follow" = 1 ]; then
      exec journalctl --user -u "$SYSTEMD_UNIT" -n "$_sil_lines" -f
    fi
    journalctl --user -u "$SYSTEMD_UNIT" -n "$_sil_lines"
    return 0
  fi

  _sil_log=$(log_file)
  if [ ! -f "$_sil_log" ]; then
    printf 'No server log at %s yet.\n' "$_sil_log"
    return 0
  fi
  if [ "$_sil_follow" = 1 ]; then
    exec tail -n "$_sil_lines" -f "$_sil_log"
  fi
  tail -n "$_sil_lines" "$_sil_log"
}

# ── Commands ─────────────────────────────────────────────────────────────────

cmd_serve() {
  parse_flags "$@"

  _ip=$(effective_ip)
  _port=$(effective_port)
  state_save "$_ip" "$_port"

  printf 'Genesis server (foreground): %s\n' "$(dashboard_url "$_ip" "$_port")"
  case $_ip in
    0.0.0.0 | ::)
      printf 'Listening on all interfaces (%s); open the URL above from this host.\n' "$_ip"
      ;;
  esac

  PHX_IP=$_ip
  PORT=$_port
  export PHX_IP PORT
  if [ -n "$FLAG_HOST" ]; then
    PHX_HOST=$FLAG_HOST
    export PHX_HOST
  fi

  exec "$LAUNCHER" start
}

cmd_start() {
  parse_flags "$@"

  # `start --foreground` is just `serve`.
  if [ "$FLAG_FOREGROUND" = 1 ]; then
    cmd_serve "$@"
    return 0
  fi

  _ip=$(effective_ip)
  _port=$(effective_port)
  _url=$(dashboard_url "$_ip" "$_port")

  if service_active; then
    printf 'Genesis server is already running.\n'
    printf 'Dashboard: %s\n' "$_url"
    return 0
  fi

  start_and_wait "$_ip" "$_port" "$FLAG_HOST"
}

cmd_stop() {
  if do_stop; then
    printf 'Genesis server stopped.\n'
  else
    printf 'Genesis server is not running.\n'
  fi
  return 0
}

cmd_restart() {
  parse_flags "$@"

  if do_stop; then
    printf 'Stopped the running server.\n'
    # Wait for the service to disappear before starting again, so the new
    # health poll cannot succeed against the outgoing process.
    _i=0
    while [ "$_i" -lt 10 ]; do
      service_active || break
      sleep 1
      _i=$((_i + 1))
    done
  else
    printf 'Genesis server was not running.\n'
  fi

  cmd_start "$@"
}

cmd_status() {
  parse_flags "$@"

  _ip=$(effective_ip)
  _port=$(effective_port)
  _url=$(dashboard_url "$_ip" "$_port")
  _backend=$(service_backend)

  case $_backend in
    systemd)
      _state=$(systemctl --user is-active "$SYSTEMD_UNIT" 2>/dev/null || true)
      [ -n "$_state" ] || _state=unknown
      ;;
    launchd)
      if launchd_loaded; then _state='loaded'; else _state='not loaded'; fi
      ;;
    *)
      if pidfile_active; then
        _state="running (pid $(sed -n '1p' "$(pid_file)" | tr -d '[:space:]'))"
      else
        _state='not running'
      fi
      ;;
  esac

  _rc=0
  probe_health "$_url" || _rc=$?

  printf 'Backend: %s\n' "$_backend"
  printf 'Service: %s\n' "$_state"
  printf 'URL:     %s\n' "$_url"
  case $_rc in
    0) printf 'Health:  ok (HTTP 200)\n' ;;
    2) printf 'Health:  unknown (neither curl nor wget is installed)\n' ;;
    *) printf 'Health:  unreachable\n' ;;
  esac

  if [ "$_rc" -eq 0 ]; then return 0; fi
  return 1
}

cmd_logs() {
  _follow=0
  _lines=200

  while [ $# -gt 0 ]; do
    case $1 in
      -f | --follow)
        _follow=1
        shift
        ;;
      -n | --lines)
        [ $# -ge 2 ] || die "$1 requires a value"
        _lines=$2
        shift 2
        ;;
      --lines=*)
        _lines=${1#--lines=}
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      *)
        die "unknown option for logs: $1"
        ;;
    esac
  done

  show_instance_logs "$_follow" "$_lines"
}

cmd_url() {
  parse_flags "$@"
  dashboard_url "$(effective_ip)" "$(effective_port)"
}

cmd_version() {
  printf 'genesis %s\n' "$(release_version)"
}

# ── Self-update (genesis update) ─────────────────────────────────────────────

# `genesis update` installs a released server build over the tree this script
# lives in. Everything that can fail — the release feed, the download, the
# checksum, the extraction and the staged release version — is validated BEFORE
# the running service is touched, and the swap itself is two renames with the
# previous tree kept aside until the new version answers /health, so a failed
# update rolls back instead of leaving a half-installed server.
#
# The feed is JSON written by the release job, but this file deliberately
# depends on nothing beyond coreutils (plus curl-or-wget): the manifest is read
# line-oriented with sed/awk. A release that publishes no checksum is tolerated
# exactly like `scripts/install.sh` tolerates it (warn and continue), because a
# first upgrade away from an older release must still be possible.

UPD_DEFAULT_WAIT=30
UPD_CHECK=0
UPD_JSON=0
UPD_VERSION=""
UPD_VERSION_TAG=""
UPD_VERSION_DISPLAY=""
UPD_FORCE=0
UPD_WAIT=$UPD_DEFAULT_WAIT
UPD_PLATFORM=""
UPD_ASSET=""
UPD_ASSET_URL=""
UPD_MANIFEST_URL=""
# Trailing state of an in-flight update; "" rather than unset (`set -u`).
UPD_TMP_DIR=""
UPD_STAGE_DIR=""
UPD_OLD_DIR=""
UPD_LOCK_DIR=""

update_usage() {
  cat <<'EOF'
Usage: genesis update [options]        (alias: genesis upgrade)

Install the newest Genesis server release (or a pinned one) over this install.
The feed, the download, the checksum and the extracted tree are all verified
BEFORE the running server is touched, and the previous tree is kept aside until
the new version answers /health — a failed update rolls back automatically.

Options:
  --check              Only check for a newer release; nothing is downloaded,
                       installed or stopped (exit 10 when one is available)
  --json               With --check, print ONE line of JSON and nothing else:
                       {"current":"<v>","latest":"<v>","available":true|false}
                       (plus "pub_date" when the release publishes one)
  --version TAG        Install this release tag (v0.13.0 or 0.13.0);
                       default: the latest release
  --force              Reinstall even when the target is already installed, and
                       bypass the active-task / foreground-server safety guard
  --wait N             Seconds to wait for /health after the restart (default 30)
  --no-linger          Do not offer to enable systemd lingering when restarting
  -h, --help           Show this help

Environment (read at run time):
  GENESIS_DOWNLOAD_BASE           Release feed base
                                  (default https://genesis.evox.group/dl)
  GENESIS_DOWNLOAD_FALLBACK_BASE  Fallback feed base
                                  (default the GitHub releases page:
                                  https://github.com/EMI-Group/genesis/releases)

Exit codes: 0 = success or already up to date, 10 = update available (--check
only), 1 = failure, 2 = usage error.
EOF
}

update_usage_error() {
  printf 'genesis: %s\n' "$*" >&2
  printf 'Run "genesis update --help" for usage.\n' >&2
  exit 2
}

# ── Release version and version comparison ───────────────────────────────────

# The installed release version: the boot script's `version` answer first (it
# needs no BEAM boot), else releases/start_erl.data ("<erts> <release>"), else
# `unknown`. Shared by `genesis version` and `genesis update`.
release_version() {
  _rv_v=""
  if [ -x "$LAUNCHER" ]; then
    _rv_v=$("$LAUNCHER" version 2>/dev/null | head -n 1 || true)
  fi
  if [ -z "$_rv_v" ]; then
    _rv_data=$GENESIS_HOME/releases/start_erl.data
    if [ -f "$_rv_data" ]; then
      _rv_v=$(head -n 1 "$_rv_data" | awk '{print $2}' || true)
    fi
  fi
  if [ -z "$_rv_v" ]; then _rv_v=unknown; fi
  printf '%s\n' "$_rv_v"
}

# Same source as release_version, but for an arbitrary (staged) release tree.
upd_tree_version() {
  _tv_data=$1/releases/start_erl.data
  if [ -f "$_tv_data" ]; then
    head -n 1 "$_tv_data" | awk 'NF >= 2 { print $2 }'
  fi
  return 0
}

# Drop a leading `v` and any -prerelease / +build suffix.
version_normalize() {
  _vn_v=$1
  case $_vn_v in v*) _vn_v=${_vn_v#v} ;; esac
  case $_vn_v in *-*) _vn_v=${_vn_v%%-*} ;; esac
  case $_vn_v in *+*) _vn_v=${_vn_v%%+*} ;; esac
  printf '%s\n' "$_vn_v"
}

# 0 when $1 is strictly newer than $2. Dot-separated numeric components, with
# missing components read as 0, so 0.13 and 0.13.0 compare equal.
version_gt() {
  _vg_a=$(version_normalize "$1")
  _vg_b=$(version_normalize "$2")
  _vg_newer=$(awk -v a="$_vg_a" -v b="$_vg_b" 'BEGIN {
    na = split(a, x, ".")
    nb = split(b, y, ".")
    n = (na > nb ? na : nb)
    for (i = 1; i <= n; i++) {
      xa = (i <= na ? x[i] + 0 : 0)
      xb = (i <= nb ? y[i] + 0 : 0)
      if (xa > xb) { print 1; exit }
      if (xa < xb) { print 0; exit }
    }
    print 0
  }')
  [ "$_vg_newer" = 1 ]
}

# ── Feed, JSON and download helpers ──────────────────────────────────────────

# Bases are joined with "/", so trailing slashes are trimmed; an empty result
# falls back to the built-in default.
upd_trim_base() {
  _tb=$1
  while [ "${_tb%/}" != "$_tb" ]; do _tb=${_tb%/}; done
  [ -n "$_tb" ] || _tb=$2
  printf '%s\n' "$_tb"
}

upd_download_base() {
  upd_trim_base "${GENESIS_DOWNLOAD_BASE:-https://genesis.evox.group/dl}" \
    https://genesis.evox.group/dl
}

upd_fallback_base() {
  upd_trim_base \
    "${GENESIS_DOWNLOAD_FALLBACK_BASE:-https://github.com/EMI-Group/genesis/releases}" \
    https://github.com/EMI-Group/genesis/releases
}

# Platform keys of the published server builds: linux_x64, linux_arm64,
# darwin_arm64. Anything else fails with the list of available builds.
update_platform_key() {
  _upk_os=$(uname -s 2>/dev/null || printf 'unknown')
  _upk_arch=$(uname -m 2>/dev/null || printf 'unknown')
  case $_upk_os in
    Linux) _upk_os=linux ;;
    Darwin) _upk_os=darwin ;;
    *) _upk_os="" ;;
  esac
  case $_upk_arch in
    x86_64 | amd64) _upk_arch=x64 ;;
    aarch64 | arm64) _upk_arch=arm64 ;;
    *) _upk_arch="" ;;
  esac
  _upk_key=$(printf '%s_%s' "$_upk_os" "$_upk_arch")
  if [ -z "$_upk_os" ] || [ -z "$_upk_arch" ]; then
    die "no Genesis server build for $(uname -s 2>/dev/null || printf 'unknown')/$(uname -m 2>/dev/null || printf 'unknown') (available: linux_x64, linux_arm64, darwin_arm64)"
  fi
  case $_upk_key in
    linux_x64 | linux_arm64 | darwin_arm64) ;;
    *)
      die "no Genesis server build for $_upk_key (available: linux_x64, linux_arm64, darwin_arm64)"
      ;;
  esac
  printf '%s\n' "$_upk_key"
}

update_asset_name() { printf 'genesis_server_%s.tar.xz\n' "$1"; }

# Feed URL(s) for a tag ("" = latest), primary first, then the GitHub fallback.
update_manifest_urls() {
  _um_tag=$1
  _um_base=$(upd_download_base)
  _um_fb=$(upd_fallback_base)
  if [ -z "$_um_tag" ]; then
    printf '%s/latest.json\n' "$_um_base"
    printf '%s/latest/download/latest.json\n' "$_um_fb"
  else
    printf '%s/%s/latest.json\n' "$_um_base" "$_um_tag"
    printf '%s/download/%s/latest.json\n' "$_um_fb" "$_um_tag"
  fi
}

# Tarball URL(s) for a tag ("" = latest), same primary/fallback shapes.
update_asset_urls() {
  _ua_tag=$1
  _ua_asset=$2
  _ua_base=$(upd_download_base)
  _ua_fb=$(upd_fallback_base)
  if [ -z "$_ua_tag" ]; then
    printf '%s/%s\n' "$_ua_base" "$_ua_asset"
    printf '%s/latest/download/%s\n' "$_ua_fb" "$_ua_asset"
  else
    printf '%s/%s/%s\n' "$_ua_base" "$_ua_tag" "$_ua_asset"
    printf '%s/download/%s/%s\n' "$_ua_fb" "$_ua_tag" "$_ua_asset"
  fi
}

# Fetch a URL into a file. curl runs with -f so an HTTP >= 400 answer is a
# failure instead of an HTML error page saved as the download.
update_fetch() {
  _uf_url=$1
  _uf_dest=$2
  case $(probe_tool) in
    curl)
      curl -fsSL --retry 2 --retry-delay 1 --connect-timeout 20 \
        -o "$_uf_dest" "$_uf_url" </dev/null
      ;;
    wget)
      wget -q -O "$_uf_dest" "$_uf_url" </dev/null
      ;;
    *)
      die "neither curl nor wget is available; install one of them and retry"
      ;;
  esac
}

# Extracted STRING value of "key" from a JSON text. Deliberately tolerant and
# line-oriented: a pretty-printed manifest puts each field on its own line,
# while a compact JSON body is one line, so both shapes are handled.
json_field() {
  _jf_text=$1
  _jf_key=$2
  _jf_out=$(printf '%s\n' "$_jf_text" | tr -d '\r' |
    sed -n "s/.*\"$_jf_key\"[[:space:]]*:[[:space:]]*\"\(.*\)\"[[:space:]]*,\{0,1\}[[:space:]]*$/\1/p" |
    head -n 1)
  if [ -z "$_jf_out" ]; then
    _jf_out=$(printf '%s\n' "$_jf_text" | tr -d '\r' |
      sed -n "s/.*\"$_jf_key\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" | head -n 1)
  fi
  if [ -n "$_jf_out" ]; then printf '%s\n' "$_jf_out"; fi
  return 0
}

# Extracted numeric value of "key" from a JSON text ("" when absent).
json_number() {
  _jn_text=$1
  _jn_key=$2
  _jn_out=$(printf '%s\n' "$_jn_text" | tr -d '\r' |
    sed -n "s/.*\"$_jn_key\"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p" | head -n 1)
  if [ -n "$_jn_out" ]; then printf '%s\n' "$_jn_out"; fi
  return 0
}

# sha256 published for a platform entry of the manifest ("" when the release
# does not publish one). `$3 = 0` searches the whole file instead of only the
# "server" object, so a manifest without that wrapper is still readable.
upd_manifest_sha_scope() {
  _mss_file=$1
  _mss_plat=$2
  _mss_scoped=$3
  awk -v plat="\"$_mss_plat\"" -v want="\"sha256\"" -v scoped="$_mss_scoped" '
    {
      if (scoped == 1 && !in_server) {
        if (index($0, "\"server\"") == 0) next
        in_server = 1
      }
      if (inside == 1) {
        if ($0 ~ /^[ \t]*}/) exit
        if (index($0, want) > 0) {
          v = $0
          sub(/^[^:]*:[ \t]*/, "", v)
          sub(/[ \t]*,[ \t]*$/, "", v)
          gsub(/"/, "", v)
          print v
          exit
        }
        next
      }
      if (index($0, plat) > 0) inside = 1
    }' "$_mss_file"
}

upd_manifest_sha() {
  _ms_file=$1
  _ms_plat=$2
  [ -f "$_ms_file" ] || return 0
  _ms_out=$(upd_manifest_sha_scope "$_ms_file" "$_ms_plat" 1)
  if [ -z "$_ms_out" ]; then
    _ms_out=$(upd_manifest_sha_scope "$_ms_file" "$_ms_plat" 0)
  fi
  if [ -n "$_ms_out" ]; then printf '%s\n' "$_ms_out"; fi
  return 0
}

# 0 = verified, 1 = mismatch, 2 = cannot verify (no sha256sum/shasum).
upd_verify_sha() {
  _vs_file=$1
  _vs_expected=$(printf '%s' "$2" | tr 'A-Z' 'a-z')
  _vs_actual=""
  if command -v sha256sum >/dev/null 2>&1; then
    _vs_actual=$(sha256sum "$_vs_file" 2>/dev/null | awk '{ print $1 }' || true)
  elif command -v shasum >/dev/null 2>&1; then
    _vs_actual=$(shasum -a 256 "$_vs_file" 2>/dev/null | awk '{ print $1 }' || true)
  else
    return 2
  fi
  [ -n "$_vs_actual" ] || return 2
  _vs_actual=$(printf '%s' "$_vs_actual" | tr 'A-Z' 'a-z')
  [ "$_vs_actual" = "$_vs_expected" ] || return 1
  return 0
}

# ── Lock, cleanup and safety gate ────────────────────────────────────────────

upd_unlock() {
  if [ -n "${UPD_LOCK_DIR:-}" ] && [ -d "$UPD_LOCK_DIR" ]; then
    rm -rf "$UPD_LOCK_DIR"
  fi
  UPD_LOCK_DIR=""
}

# Atomic `mkdir` lock stamped with our pid: a concurrent update must never
# race a swap. A lock whose owner is gone (a killed earlier run) is stale and
# is recovered instead of wedging updates forever.
upd_lock() {
  _lk_dir=$(data_dir)
  mkdir -p "$_lk_dir"
  _lk_path="$_lk_dir/update.lock"
  _lk_try=0
  while [ "$_lk_try" -lt 3 ]; do
    if mkdir "$_lk_path" 2>/dev/null; then
      printf '%s\n' "$$" >"$_lk_path/pid"
      UPD_LOCK_DIR=$_lk_path
      return 0
    fi
    _lk_pid=$(sed -n '1p' "$_lk_path/pid" 2>/dev/null | tr -d '[:space:]' || true)
    if [ -z "$_lk_pid" ]; then
      # The winner writes its pid right after mkdir: give it a moment before
      # declaring the lock stale.
      sleep 1
      _lk_pid=$(sed -n '1p' "$_lk_path/pid" 2>/dev/null | tr -d '[:space:]' || true)
    fi
    case $_lk_pid in
      '' | *[!0-9]*) ;;
      *)
        if kill -0 "$_lk_pid" 2>/dev/null; then
          die "another update is in progress (pid $_lk_pid); wait for it to finish, or remove $_lk_path if that pid is gone"
        fi
        ;;
    esac
    rm -rf "$_lk_path"
    _lk_try=$((_lk_try + 1))
  done
  die "could not acquire the update lock ($_lk_path)"
}

# Idempotent teardown shared by the EXIT/INT/TERM traps: it never deletes the
# live install, and it puts the previous tree back when a kill landed between
# the two swap renames.
upd_teardown() {
  if [ -n "${UPD_OLD_DIR:-}" ] && [ -d "$UPD_OLD_DIR" ] && [ ! -e "$GENESIS_HOME" ]; then
    mv "$UPD_OLD_DIR" "$GENESIS_HOME" 2>/dev/null || true
  fi
  UPD_OLD_DIR=""
  if [ -n "${UPD_STAGE_DIR:-}" ] && [ -d "$UPD_STAGE_DIR" ]; then
    rm -rf "$UPD_STAGE_DIR" 2>/dev/null || true
  fi
  UPD_STAGE_DIR=""
  if [ -n "${UPD_TMP_DIR:-}" ] && [ -d "$UPD_TMP_DIR" ]; then
    rm -rf "$UPD_TMP_DIR" 2>/dev/null || true
  fi
  UPD_TMP_DIR=""
  upd_unlock
}

upd_cleanup() {
  _uc_rc=$?
  trap - EXIT INT TERM
  upd_teardown
  exit "$_uc_rc"
}

upd_abort() {
  printf 'Genesis update interrupted; cleaning up.\n' >&2
  upd_teardown
  exit "$1"
}

# Active tasks reported by the running instance's /server/status endpoint. An
# older release that has no such endpoint (or no readable count) only warns:
# the FIRST upgrade away from it must work.
upd_check_active_tasks() {
  _at_url=$1/server/status
  _at_body=""
  case $(probe_tool) in
    curl)
      _at_body=$(curl -fsS -m "$PROBE_TIMEOUT" "$_at_url" 2>/dev/null || true)
      ;;
    wget)
      _at_body=$(wget -qO- -T "$PROBE_TIMEOUT" "$_at_url" 2>/dev/null || true)
      ;;
    *)
      printf 'Warning: cannot check for running tasks (neither curl nor wget is installed).\n' >&2
      return 0
      ;;
  esac
  if [ -z "$_at_body" ]; then
    printf 'Warning: could not read %s; assuming no tasks are running.\n' "$_at_url" >&2
    return 0
  fi
  _at_n=$(json_number "$_at_body" active_tasks)
  case $_at_n in
    '')
      printf 'Warning: %s does not report active_tasks (older release); continuing.\n' "$_at_url" >&2
      return 0
      ;;
    *[!0-9]*)
      printf 'Warning: %s reported an unreadable active task count; continuing.\n' "$_at_url" >&2
      return 0
      ;;
  esac
  if [ "$_at_n" -gt 0 ]; then
    if [ "$UPD_FORCE" = 1 ]; then
      printf 'Warning: the Genesis server has %s active task(s); updating anyway (--force).\n' "$_at_n" >&2
      return 0
    fi
    printf 'The Genesis server has %s active task(s); updating now would interrupt them.\n' "$_at_n" >&2
    printf 'Wait for them to finish, or pass --force to update anyway.\n' >&2
    exit 1
  fi
  return 0
}

# 0 = a service is running (safe to stop and restart), 1 = nothing is running.
# Refuses (exit 1) unless --force when the update would disturb a live server.
upd_busy_check() {
  _bc_url=$(dashboard_url "$(effective_ip)" "$(effective_port)")

  if service_active; then
    upd_check_active_tasks "$_bc_url"
    return 0
  fi

  # No supervised service, yet /health answers: a foreground `genesis serve`
  # owns the port, so a restart is impossible and stopping would not help.
  _bc_rc=0
  probe_health "$_bc_url" >/dev/null 2>&1 || _bc_rc=$?
  if [ "$_bc_rc" -eq 0 ]; then
    if [ "$UPD_FORCE" = 1 ]; then
      printf 'Warning: a foreground Genesis server is running at %s; installing anyway (--force).\n' "$_bc_url" >&2
      return 1
    fi
    printf 'A foreground Genesis server is running at %s (started with `genesis serve`).\n' "$_bc_url" >&2
    printf 'Stop it (Ctrl-C in its terminal) before updating, or pass --force to replace the files anyway.\n' >&2
    exit 1
  fi
  return 1
}

# ── Fetching the feed, the tarball and the staged tree ───────────────────────

upd_fetch_manifest() {
  _fm_tag=$1
  _fm_dest=$2
  _fm_prev=""
  for _fm_url in $(update_manifest_urls "$_fm_tag"); do
    # A duplicated attempt when both bases resolve to the same URL.
    if [ -n "$_fm_prev" ] && [ "$_fm_url" = "$_fm_prev" ]; then continue; fi
    _fm_prev=$_fm_url
    if update_fetch "$_fm_url" "$_fm_dest" >/dev/null 2>&1 && [ -s "$_fm_dest" ]; then
      UPD_MANIFEST_URL=$_fm_url
      return 0
    fi
    printf 'Warning: could not fetch %s\n' "$_fm_url" >&2
  done
  return 1
}

upd_fetch_asset() {
  _fa_asset=$1
  _fa_tag=$2
  _fa_dest=$3
  _fa_prev=""
  for _fa_url in $(update_asset_urls "$_fa_tag" "$_fa_asset"); do
    if [ -n "$_fa_prev" ] && [ "$_fa_url" = "$_fa_prev" ]; then continue; fi
    _fa_prev=$_fa_url
    if update_fetch "$_fa_url" "$_fa_dest" >/dev/null 2>&1 && [ -s "$_fa_dest" ]; then
      UPD_ASSET_URL=$_fa_url
      return 0
    fi
    printf 'Warning: download failed: %s\n' "$_fa_url" >&2
  done
  return 1
}

# Take a file's published .sha256 (first field of line 1) when it is a 64-hex
# digest; "" otherwise.
upd_read_sha_file() {
  _rs_file=$1
  [ -f "$_rs_file" ] || return 0
  _rs_v=$(awk 'NR == 1 { print $1 }' "$_rs_file" 2>/dev/null || true)
  _rs_v=$(printf '%s' "$_rs_v" | tr 'A-Z' 'a-z')
  if [ "${#_rs_v}" -eq 64 ]; then
    case $_rs_v in
      *[!0-9a-f]*) ;;
      *) printf '%s\n' "$_rs_v" ;;
    esac
  fi
  return 0
}

upd_print_json() {
  _pj_current=$1
  _pj_latest=$2
  _pj_available=$3
  _pj_pub=$4
  if [ -n "$_pj_pub" ]; then
    printf '{"current":"%s","latest":"%s","available":%s,"pub_date":"%s"}\n' \
      "$_pj_current" "$_pj_latest" "$_pj_available" "$_pj_pub"
  else
    printf '{"current":"%s","latest":"%s","available":%s}\n' \
      "$_pj_current" "$_pj_latest" "$_pj_available"
  fi
}

# Release notes are best-effort: literal `\n` escapes become line breaks and
# escaped quotes are unescaped, then every resulting line is indented by two
# spaces (sed runs after awk so multi-line notes stay uniformly indented).
upd_print_notes() {
  _pn_notes=$1
  [ -n "$_pn_notes" ] || return 0
  printf 'Notes:\n'
  printf '%s\n' "$_pn_notes" |
    awk '{ gsub(/\\"/, "\""); gsub(/\\n/, "\n"); print }' |
    sed 's/^/  /'
}

# ── Update flag parsing and command ──────────────────────────────────────────

# `genesis update` parses its OWN flags: `parse_flags` is shared with the
# lifecycle commands and rejects everything it does not know.
parse_update_flags() {
  UPD_CHECK=0
  UPD_JSON=0
  UPD_VERSION=""
  UPD_VERSION_TAG=""
  UPD_VERSION_DISPLAY=""
  UPD_FORCE=0
  UPD_WAIT=$UPD_DEFAULT_WAIT

  while [ $# -gt 0 ]; do
    case $1 in
      --check)
        UPD_CHECK=1
        shift
        ;;
      --json)
        UPD_JSON=1
        shift
        ;;
      --force)
        UPD_FORCE=1
        shift
        ;;
      --version=*)
        UPD_VERSION=${1#--version=}
        [ -n "$UPD_VERSION" ] || update_usage_error "--version requires a value"
        shift
        ;;
      --version)
        [ $# -ge 2 ] || update_usage_error "--version requires a value"
        [ -n "$2" ] || update_usage_error "--version requires a value"
        UPD_VERSION=$2
        shift 2
        ;;
      --wait=*)
        UPD_WAIT=${1#--wait=}
        [ -n "$UPD_WAIT" ] || update_usage_error "--wait requires a value"
        shift
        ;;
      --wait)
        [ $# -ge 2 ] || update_usage_error "--wait requires a value"
        [ -n "$2" ] || update_usage_error "--wait requires a value"
        UPD_WAIT=$2
        shift 2
        ;;
      --no-linger)
        # Same meaning as for `start`: the restart path reuses ensure_linger.
        FLAG_NO_LINGER=1
        shift
        ;;
      -h | --help)
        update_usage
        exit 0
        ;;
      --)
        shift
        break
        ;;
      *)
        update_usage_error "unknown option for 'genesis update': $1"
        ;;
    esac
  done

  case $UPD_WAIT in
    '' | *[!0-9]*) update_usage_error "invalid --wait (digits only): $UPD_WAIT" ;;
  esac
  if [ "$UPD_WAIT" -lt 1 ]; then
    update_usage_error "--wait must be at least 1 second"
  fi

  if [ -n "$UPD_VERSION" ]; then
    # Tags are v-prefixed in URLs and displayed without the prefix.
    case $UPD_VERSION in
      v*) UPD_VERSION_TAG=$UPD_VERSION ;;
      *) UPD_VERSION_TAG=v$UPD_VERSION ;;
    esac
    UPD_VERSION_DISPLAY=$(printf '%s' "$UPD_VERSION" | sed 's/^v//')
    case $UPD_VERSION_DISPLAY in
      '' | *[!A-Za-z0-9._-]*) update_usage_error "invalid --version: $UPD_VERSION" ;;
    esac
  fi
}

cmd_update() {
  parse_update_flags "$@"

  # Nothing is mutated before the busy check, the lock and a verified download,
  # so these traps only ever guard an in-flight swap.
  trap 'upd_cleanup' EXIT
  trap 'upd_abort 130' INT
  trap 'upd_abort 143' TERM

  UPD_PLATFORM=$(update_platform_key)
  UPD_ASSET=$(update_asset_name "$UPD_PLATFORM")
  _upd_current=$(release_version)

  UPD_TMP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/genesis-update.XXXXXX") ||
    die "cannot create a temporary directory"
  _upd_manifest=$UPD_TMP_DIR/latest.json

  if ! upd_fetch_manifest "$UPD_VERSION_TAG" "$_upd_manifest"; then
    die "could not fetch the Genesis release feed (${UPD_VERSION_DISPLAY:-latest}); check your network or set GENESIS_DOWNLOAD_BASE"
  fi

  _upd_text=$(cat "$_upd_manifest")
  _upd_manifest_version=$(json_field "$_upd_text" version)
  if [ -z "$_upd_manifest_version" ]; then
    die "the Genesis release feed at $UPD_MANIFEST_URL has no version"
  fi
  _upd_pub=$(json_field "$_upd_text" pub_date)
  _upd_notes=$(json_field "$_upd_text" notes)

  if [ -n "$UPD_VERSION_DISPLAY" ]; then
    _upd_target=$UPD_VERSION_DISPLAY
  else
    _upd_target=$_upd_manifest_version
  fi

  # Latest mode never downgrades; an explicit --version may install any release
  # (older or newer), and --force reinstalls the same version.
  _upd_need=0
  if [ "$UPD_FORCE" = 1 ]; then
    _upd_need=1
  elif [ -z "$UPD_VERSION_TAG" ]; then
    if version_gt "$_upd_target" "$_upd_current"; then
      _upd_need=1
    fi
  elif [ "$(version_normalize "$_upd_target")" != "$(version_normalize "$_upd_current")" ]; then
    _upd_need=1
  fi
  if [ "$_upd_need" = 1 ] && [ "$_upd_current" = unknown ]; then
    printf 'Warning: could not determine the installed Genesis version; installing %s.\n' "$_upd_target" >&2
  fi

  if [ "$_upd_need" = 0 ]; then
    if [ "$UPD_CHECK" = 1 ] && [ "$UPD_JSON" = 1 ]; then
      upd_print_json "$_upd_current" "$_upd_target" false "$_upd_pub"
    else
      printf 'Genesis %s is up to date.\n' "$_upd_current"
    fi
    return 0
  fi

  if [ "$UPD_CHECK" = 1 ]; then
    if [ "$UPD_JSON" = 1 ]; then
      upd_print_json "$_upd_current" "$_upd_target" true "$_upd_pub"
    else
      printf 'Update available: %s (installed %s)\n' "$_upd_target" "$_upd_current"
      if [ -n "$_upd_pub" ]; then printf 'Released: %s\n' "$_upd_pub"; fi
      upd_print_notes "$_upd_notes"
      printf 'Run `genesis update` to install it.\n'
    fi
    return 10
  fi

  # Fail before any download when the swap could not happen anyway.
  _upd_parent=$(dirname "$GENESIS_HOME")
  [ -n "$_upd_parent" ] || _upd_parent=/
  if [ ! -d "$_upd_parent" ] || [ ! -w "$_upd_parent" ]; then
    die "the parent of the install directory ($_upd_parent) is not writable; re-run the installer as the user who owns $GENESIS_HOME"
  fi

  printf 'Update available: %s (installed %s)\n' "$_upd_target" "$_upd_current"
  if [ -n "$_upd_pub" ]; then printf 'Released: %s\n' "$_upd_pub"; fi
  upd_print_notes "$_upd_notes"

  upd_lock

  _upd_was_running=1
  upd_busy_check || _upd_was_running=0

  # ── Download + verification (the server is still untouched) ──
  _upd_archive=$UPD_TMP_DIR/$UPD_ASSET
  printf 'Downloading %s (%s)\n' "$UPD_ASSET" "$_upd_target"
  if ! upd_fetch_asset "$UPD_ASSET" "$UPD_VERSION_TAG" "$_upd_archive"; then
    die "could not download $UPD_ASSET for $UPD_PLATFORM; the release may not be published yet"
  fi

  _upd_expected=$(upd_manifest_sha "$_upd_manifest" "$UPD_PLATFORM")
  _upd_expected=$(printf '%s' "$_upd_expected" | tr 'A-Z' 'a-z')
  if [ "${#_upd_expected}" -ne 64 ]; then
    _upd_expected=""
    # No digest in the manifest: fall back to a published .sha256 beside it.
    if update_fetch "$UPD_ASSET_URL.sha256" "$UPD_TMP_DIR/$UPD_ASSET.sha256" \
      >/dev/null 2>&1; then
      _upd_expected=$(upd_read_sha_file "$UPD_TMP_DIR/$UPD_ASSET.sha256")
    fi
  fi

  if [ -n "$_upd_expected" ]; then
    _upd_vrc=0
    upd_verify_sha "$_upd_archive" "$_upd_expected" || _upd_vrc=$?
    case $_upd_vrc in
      0) printf 'Checksum verified.\n' ;;
      2) printf 'Warning: no sha256sum/shasum found; skipping checksum verification.\n' >&2 ;;
      *) die "checksum mismatch for $UPD_ASSET; the download may be corrupt or tampered with (delete it and retry)" ;;
    esac
  else
    printf 'Warning: no published sha256 for %s; skipping checksum verification.\n' "$UPD_ASSET" >&2
  fi

  # ── Extraction + staged-version check (still nothing swapped) ──
  _upd_extract=$UPD_TMP_DIR/extract
  mkdir -p "$_upd_extract"
  if ! tar -xJf "$_upd_archive" -C "$_upd_extract"; then
    die "failed to extract $UPD_ASSET (the download may be corrupt, or tar lacks .tar.xz support)"
  fi
  # The tarball root is `genesis_server/`; tolerate a flat archive too.
  if [ -f "$_upd_extract/genesis_server/bin/genesis_server" ]; then
    _upd_src=$_upd_extract/genesis_server
  elif [ -f "$_upd_extract/bin/genesis_server" ]; then
    _upd_src=$_upd_extract
  else
    die "the extracted archive does not contain bin/genesis_server; $UPD_ASSET looks wrong"
  fi

  _upd_staged_version=$(upd_tree_version "$_upd_src")
  if [ -n "$_upd_staged_version" ] &&
    [ "$(version_normalize "$_upd_staged_version")" != "$(version_normalize "$_upd_target")" ]; then
    die "the downloaded release is $_upd_staged_version but $_upd_target was requested; nothing was changed"
  fi

  _upd_stage=$(mktemp -d "$_upd_parent/.genesis-update.XXXXXX") ||
    die "cannot create a staging directory next to $GENESIS_HOME"
  UPD_STAGE_DIR=$_upd_stage
  cp -R "$_upd_src/." "$UPD_STAGE_DIR/"
  if [ ! -f "$UPD_STAGE_DIR/bin/genesis_server" ]; then
    die "the staged install is incomplete (bin/genesis_server missing)"
  fi

  # ── Stop, swap, restart ──
  printf 'Installing Genesis %s to %s\n' "$_upd_target" "$GENESIS_HOME"

  _upd_ip=$(effective_ip)
  _upd_port=$(effective_port)
  _upd_url=$(dashboard_url "$_upd_ip" "$_upd_port")

  if [ "$_upd_was_running" = 1 ]; then
    printf 'Stopping the Genesis server.\n'
    do_stop || true
    _upd_i=0
    while [ "$_upd_i" -lt 10 ]; do
      service_active || break
      sleep 1
      _upd_i=$((_upd_i + 1))
    done
  fi

  UPD_OLD_DIR="$GENESIS_HOME.old.$$"
  rm -rf "$UPD_OLD_DIR"
  if ! mv "$GENESIS_HOME" "$UPD_OLD_DIR"; then
    die "failed to move the current install aside; nothing was changed"
  fi
  if ! mv "$UPD_STAGE_DIR" "$GENESIS_HOME"; then
    mv "$UPD_OLD_DIR" "$GENESIS_HOME" || printf 'Warning: could not restore the previous install from %s\n' "$UPD_OLD_DIR" >&2
    UPD_OLD_DIR=""
    die "failed to move the new release into $GENESIS_HOME"
  fi
  # Consumed by the swap above: never let the teardown delete the live tree.
  UPD_STAGE_DIR=""
  for _upd_bin in "$GENESIS_HOME"/bin/*; do
    if [ -f "$_upd_bin" ]; then chmod +x "$_upd_bin"; fi
  done

  if [ "$_upd_was_running" = 0 ]; then
    rm -rf "$UPD_OLD_DIR"
    UPD_OLD_DIR=""
    printf 'Genesis updated: %s → %s\n' "$_upd_current" "$_upd_target"
    printf 'The server was not running; run `genesis start` to start Genesis %s.\n' "$_upd_target"
    return 0
  fi

  printf 'Starting the Genesis server.\n'
  # `start_and_wait` polls /health for START_TIMEOUT seconds; --wait is this
  # restart's budget, so it overrides the constant for the rest of this run.
  START_TIMEOUT=$UPD_WAIT
  _upd_healthy=1
  # The instance re-adopts its distribution intent from <data dir>/remote/
  # desired.env at boot, so nothing has to be re-enabled here.
  start_and_wait "$_upd_ip" "$_upd_port" "" || _upd_healthy=0

  if [ "$_upd_healthy" = 1 ]; then
    rm -rf "$UPD_OLD_DIR"
    UPD_OLD_DIR=""
    printf 'Genesis updated: %s → %s\n' "$_upd_current" "$_upd_target"
    return 0
  fi

  # ── Rollback ──
  printf 'The new version did not become healthy; rolling back to %s.\n' "$_upd_current"
  do_stop || true
  _upd_i=0
  while [ "$_upd_i" -lt 10 ]; do
    service_active || break
    sleep 1
    _upd_i=$((_upd_i + 1))
  done

  case $GENESIS_HOME in
    '' | /) die "refusing to remove $GENESIS_HOME during rollback" ;;
  esac
  if [ -d "$UPD_OLD_DIR" ]; then
    rm -rf "$GENESIS_HOME"
    if mv "$UPD_OLD_DIR" "$GENESIS_HOME"; then
      UPD_OLD_DIR=""
    else
      die "could not restore the previous install from $UPD_OLD_DIR; move it back to $GENESIS_HOME by hand"
    fi
  fi

  printf 'Starting the Genesis server.\n'
  if start_and_wait "$_upd_ip" "$_upd_port" ""; then
    printf 'Genesis update failed; the previous version is running.\n'
  else
    printf 'Genesis update failed and the previous version (%s) did not start either.\n' "$_upd_current" >&2
    printf 'The previous release is installed at %s; see `genesis logs` for the failure.\n' "$GENESIS_HOME" >&2
  fi
  printf 'Dashboard: %s\n' "$_upd_url" >&2
  return 1
}

# ── SSH remote development (genesis remote) ──────────────────────────────────

# `genesis remote` toggles Erlang distribution on the ONE server instance this
# host runs: the local dashboard reaches that instance over an SSH tunnel while
# its HTTP dashboard keeps serving. No second process is ever created. The CLI
# never talks to the BEAM over distribution — it writes
# <data dir>/remote/control.request, signals the instance's main pid with SIGHUP
# and polls <data dir>/remote/dist.env for the daemon's answer
# (`EvoGit.DaemonControl`). `--unit` names the LEGACY per-target daemon unit an
# older bootstrap left behind; it is kept for compatibility and cleanup only.

REMOTE_DEFAULT_UNIT=genesis-remote
REMOTE_DEFAULT_DIST_PORT=9000
REMOTE_DEFAULT_WAIT=30
REMOTE_MIN_WAIT=10
# Budget of a `remote stop` (disable is a local operation on the live VM).
REMOTE_STOP_WAIT=10

REMOTE_NODE=""
REMOTE_COOKIE=""
REMOTE_DIST_PORT=$REMOTE_DEFAULT_DIST_PORT
REMOTE_UNIT=$REMOTE_DEFAULT_UNIT
REMOTE_WAIT=$REMOTE_DEFAULT_WAIT
REMOTE_FORCE=0
REMOTE_FOLLOW=0
REMOTE_LINES=200

remote_usage() {
  cat <<'EOF'
Usage: genesis remote <command> [options]

Enable, inspect or disable SSH remote development on the shared Genesis server
instance. Distribution is a RUNTIME TOGGLE on that single instance: `remote
start` starts it first when it is not running, then enables distribution, so no
second process, unit or pidfile is ever created.

`remote stop` only detaches distribution — the HTTP server instance KEEPS
RUNNING (use `genesis stop` to stop it). `remote logs` shows the instance's
logs, which now also carry the distribution control-plane messages.

Commands:
  remote start  --node NODE --cookie COOKIE [--dist-port 9000]
                [--unit genesis-remote] [--wait 30] [--force]
  remote stop   [--unit genesis-remote]
  remote status [--unit genesis-remote]
  remote logs   [--unit genesis-remote] [-f] [-n N]
  remote help

Options:
  --node NODE          Distribution node name (required for start)
  --cookie COOKIE      Erlang distribution cookie (required for start)
  --dist-port N        Distribution listen port (default 9000)
  --unit NAME          Legacy daemon unit name (default genesis-remote); kept for
                       compatibility and for stopping an older daemon
  --wait N             Seconds to wait for the instance's answer (default 30,
                       minimum 10)
  --force              Re-enable distribution even when it is already enabled
  -f, --follow         Follow the log (logs only)
  -n, --lines N        Log lines to show (default 200, logs only)

Both `--flag value` and `--flag=value` are accepted.
Control state lives under <data dir>/remote/ (control.request -> dist.env).
Exit codes: 0 = success (status: only while distribution is enabled),
1 = failed / not enabled / stopped, 2 = usage error.
EOF
}

remote_usage_error() {
  printf 'genesis: %s\n' "$*" >&2
  printf 'Run "genesis remote help" for usage.\n' >&2
  exit 2
}

remote_dir() { printf '%s/remote\n' "$(data_dir)"; }
remote_pid_file() { printf '%s/%s.pid\n' "$(remote_dir)" "$REMOTE_UNIT"; }

remote_launchd_label() { printf 'com.genesis.remote.%s\n' "$REMOTE_UNIT"; }

remote_launchd_plist() {
  printf '%s/Library/LaunchAgents/%s.plist\n' "${HOME:-/tmp}" "$(remote_launchd_label)"
}

# systemd scope for the LEGACY daemon unit: `system` for root, `user` otherwise.
# A root SSH login has no user manager and no session bus, so a daemon an older
# bootstrap launched there lives in the SYSTEM scope — cleanup must look there.
remote_systemd_scope() {
  if [ "$(id -u 2>/dev/null || printf '1')" = 0 ]; then
    printf 'system\n'
  else
    printf 'user\n'
  fi
}

remote_systemd_usable() {
  is_linux || return 1
  command -v systemd-run >/dev/null 2>&1 || return 1
  command -v systemctl >/dev/null 2>&1 || return 1
  # The system scope needs no user manager, so only the user scope probes one.
  if [ "$(remote_systemd_scope)" = system ]; then return 0; fi
  systemd_usable
}

remote_service_backend() {
  if remote_systemd_usable; then
    printf 'systemd\n'
  elif launchd_usable; then
    printf 'launchd\n'
  else
    printf 'fallback\n'
  fi
}

# systemctl in the scope the remote unit lives in.
remote_systemctl() {
  if [ "$(remote_systemd_scope)" = system ]; then
    systemctl "$@"
  else
    systemctl --user "$@"
  fi
}

remote_launchd_loaded() {
  launchctl print "gui/$(id -u)/$(remote_launchd_label)" >/dev/null 2>&1
}

remote_pidfile_active() {
  _rpa_pidfile=$(remote_pid_file)
  if [ ! -f "$_rpa_pidfile" ]; then return 1; fi
  _rpa_pid=$(sed -n '1p' "$_rpa_pidfile" | tr -d '[:space:]')
  if [ -z "$_rpa_pid" ]; then return 1; fi
  case $_rpa_pid in
    *[!0-9]*) return 1 ;;
  esac
  kill -0 "$_rpa_pid" 2>/dev/null
}

# 0 while the daemon is up, per the backend that owns it.
remote_running() {
  case $1 in
    systemd) remote_systemctl is-active --quiet "$REMOTE_UNIT" >/dev/null 2>&1 ;;
    launchd) remote_launchd_loaded ;;
    *) remote_pidfile_active ;;
  esac
}

# ── Runtime distribution control (control.request -> dist.env) ───────────────

control_request_file() { printf '%s/control.request\n' "$(remote_dir)"; }
dist_env_file() { printf '%s/dist.env\n' "$(remote_dir)"; }

# Read KEY from dist.env (empty when unset). Parsed, never sourced — the file is
# the daemon's own report, but a stray line must still never execute code.
dist_state_get() {
  _dsg_file=$(dist_env_file)
  if [ -f "$_dsg_file" ]; then
    sed -n "s/^$1=//p" "$_dsg_file" | tail -n 1
  fi
  return 0
}

# write_control_request <action> <node> <cookie> <dist_port> <seq>
#
# The request carries the distribution cookie, so it is created 0600 (umask)
# before it holds any content, written to a temp file in the same directory and
# renamed into place: the daemon never reads a half-written request.
write_control_request() {
  _wcr_dir=$(remote_dir)
  mkdir -p "$_wcr_dir"
  _wcr_tmp="$_wcr_dir/.control.request.tmp.$$"
  (
    umask 077
    {
      printf 'ACTION=%s\n' "$1"
      if [ "$1" = enable ]; then
        printf 'NODE=%s\n' "$2"
        printf 'COOKIE=%s\n' "$3"
        printf 'DIST_PORT=%s\n' "$4"
      fi
      printf 'SEQ=%s\n' "$5"
    } >"$_wcr_tmp"
  )
  chmod 600 "$_wcr_tmp" 2>/dev/null || true
  mv -f "$_wcr_tmp" "$_wcr_dir/control.request"
}

# 0 when dist.env carries an answer whose GENESIS_CONTROL_SEQ is $1: a stale
# file from an earlier call must never be mistaken for this request's answer.
dist_answer_seq_is() {
  [ "$(dist_state_get GENESIS_CONTROL_SEQ)" = "$1" ]
}

# wait_dist_result <seq> <budget_seconds> — poll dist.env in 100 ms steps until
# the daemon answers THIS sequence number. 0 = answered, 1 = no answer in budget.
wait_dist_result() {
  _wdr_seq=$1
  _wdr_steps=$(($2 * 10))
  _wdr_n=0
  while [ "$_wdr_n" -lt "$_wdr_steps" ]; do
    if dist_answer_seq_is "$_wdr_seq"; then return 0; fi
    _wdr_n=$((_wdr_n + 1))
    sleep 0.1
  done
  dist_answer_seq_is "$_wdr_seq"
}

# send_control <action> <node> <cookie> <dist_port> <budget>
#   0 = the instance answered ok (read dist.env for the ACTUAL state)
#   1 = it answered error (GENESIS_CONTROL_MESSAGE carries the reason)
#   2 = it did not answer within <budget> seconds
#   3 = the instance is not running or cannot be signalled
send_control() {
  _sc_seq=$$
  _sc_pid=$(instance_pid)
  if [ -z "$_sc_pid" ]; then return 3; fi

  write_control_request "$1" "$2" "$3" "$4" "$_sc_seq"

  # SIGHUP is what makes the daemon read the request: its handler calls
  # EvoGit.DaemonControl.reload/1. A failed signal leaves the request behind, so
  # it is removed to keep the next call unambiguous.
  if ! kill -HUP "$_sc_pid" 2>/dev/null; then
    rm -f "$(control_request_file)"
    return 3
  fi

  if ! wait_dist_result "$_sc_seq" "$5"; then return 2; fi
  if [ "$(dist_state_get GENESIS_CONTROL_RESULT)" = ok ]; then return 0; fi
  return 1
}

# The daemon's one-line failure reason, on stderr.
print_control_message() {
  _pcm=$(dist_state_get GENESIS_CONTROL_MESSAGE)
  [ -n "$_pcm" ] || _pcm='the server instance reported a failure'
  printf '%s\n' "$_pcm" >&2
}

# The canonical running line. The Elixir caller parses
# `^running\s+node=(\S+)\s+dist_port=(\d+)`, so this wording is a contract.
print_dist_running() {
  _pdr_node=$(dist_state_get GENESIS_NODE)
  _pdr_port=$(dist_state_get GENESIS_DIST_PORT)
  [ -n "$_pdr_node" ] || _pdr_node=unknown
  [ -n "$_pdr_port" ] || _pdr_port=unknown
  printf 'running node=%s dist_port=%s\n' "$_pdr_node" "$_pdr_port"
}

# 0 when distribution is enabled for exactly this node.
dist_enabled_for() {
  [ "$(dist_state_get GENESIS_DIST_ENABLED)" = 1 ] || return 1
  [ "$(dist_state_get GENESIS_NODE)" = "$1" ] || return 1
  return 0
}

# A bootstrap from before the single-instance model left a SECOND,
# distribution-only daemon unit per target (genesis-remote[-<id>]) on the host;
# it conflicts with the shared instance, so the first `remote start` after an
# upgrade stops it — in the scope it was launched in, since an old root/SSH
# bootstrap used the SYSTEM scope.
cleanup_legacy_daemon() {
  _cld_backend=$(remote_service_backend)
  if ! remote_running "$_cld_backend"; then
    # A stale pidfile would otherwise shadow the instance as "the daemon".
    if [ "$_cld_backend" = fallback ]; then rm -f "$(remote_pid_file)"; fi
    return 0
  fi
  do_remote_stop "$_cld_backend"
  printf 'Stopped the legacy remote daemon (unit %s); distribution now runs on the shared server instance.\n' "$REMOTE_UNIT"
  return 0
}

do_remote_stop() {
  case $1 in
    systemd)
      if ! remote_systemctl stop "$REMOTE_UNIT"; then
        die "could not stop $REMOTE_UNIT"
      fi
      remote_systemctl reset-failed "$REMOTE_UNIT" >/dev/null 2>&1 || true
      return 0
      ;;
    launchd)
      launchctl bootout "gui/$(id -u)/$(remote_launchd_label)" >/dev/null 2>&1 || true
      return 0
      ;;
    *)
      _drs_pidfile=$(remote_pid_file)
      _drs_pid=$(sed -n '1p' "$_drs_pidfile" 2>/dev/null | tr -d '[:space:]' || true)
      if [ -n "$_drs_pid" ]; then
        # TERM first: the VM shuts down cleanly and flushes its SQLite WAL.
        kill -TERM "$_drs_pid" 2>/dev/null || true
        _drs_i=0
        while [ "$_drs_i" -lt 10 ]; do
          kill -0 "$_drs_pid" 2>/dev/null || break
          sleep 1
          _drs_i=$((_drs_i + 1))
        done
      fi
      rm -f "$_drs_pidfile"
      return 0
      ;;
  esac
}

# ── Remote flag parsing ──────────────────────────────────────────────────────

# parse_remote_flags <mode> [options...] — `mode` is `start`, `service`
# (stop/status) or `logs`, and gates which options are legal.
parse_remote_flags() {
  _prf_mode=$1
  shift

  REMOTE_NODE=""
  REMOTE_COOKIE=""
  REMOTE_DIST_PORT=$REMOTE_DEFAULT_DIST_PORT
  REMOTE_UNIT=$REMOTE_DEFAULT_UNIT
  REMOTE_WAIT=$REMOTE_DEFAULT_WAIT
  REMOTE_FORCE=0
  REMOTE_FOLLOW=0
  REMOTE_LINES=200

  while [ $# -gt 0 ]; do
    case $1 in
      --node=*)
        _prf_val=${1#--node=}
        [ -n "$_prf_val" ] || remote_usage_error "--node requires a value"
        REMOTE_NODE=$_prf_val
        shift
        ;;
      --node)
        [ $# -ge 2 ] || remote_usage_error "--node requires a value"
        [ -n "$2" ] || remote_usage_error "--node requires a value"
        REMOTE_NODE=$2
        shift 2
        ;;
      --cookie=*)
        _prf_val=${1#--cookie=}
        [ -n "$_prf_val" ] || remote_usage_error "--cookie requires a value"
        REMOTE_COOKIE=$_prf_val
        shift
        ;;
      --cookie)
        [ $# -ge 2 ] || remote_usage_error "--cookie requires a value"
        [ -n "$2" ] || remote_usage_error "--cookie requires a value"
        REMOTE_COOKIE=$2
        shift 2
        ;;
      --dist-port=*)
        _prf_val=${1#--dist-port=}
        [ -n "$_prf_val" ] || remote_usage_error "--dist-port requires a value"
        REMOTE_DIST_PORT=$_prf_val
        shift
        ;;
      --dist-port)
        [ $# -ge 2 ] || remote_usage_error "--dist-port requires a value"
        [ -n "$2" ] || remote_usage_error "--dist-port requires a value"
        REMOTE_DIST_PORT=$2
        shift 2
        ;;
      --unit=*)
        _prf_val=${1#--unit=}
        [ -n "$_prf_val" ] || remote_usage_error "--unit requires a value"
        REMOTE_UNIT=$_prf_val
        shift
        ;;
      --unit)
        [ $# -ge 2 ] || remote_usage_error "--unit requires a value"
        [ -n "$2" ] || remote_usage_error "--unit requires a value"
        REMOTE_UNIT=$2
        shift 2
        ;;
      --wait=*)
        _prf_val=${1#--wait=}
        [ -n "$_prf_val" ] || remote_usage_error "--wait requires a value"
        REMOTE_WAIT=$_prf_val
        shift
        ;;
      --wait)
        [ $# -ge 2 ] || remote_usage_error "--wait requires a value"
        [ -n "$2" ] || remote_usage_error "--wait requires a value"
        REMOTE_WAIT=$2
        shift 2
        ;;
      --force)
        REMOTE_FORCE=1
        shift
        ;;
      -f | --follow)
        REMOTE_FOLLOW=1
        shift
        ;;
      -n | --lines)
        [ $# -ge 2 ] || remote_usage_error "$1 requires a value"
        REMOTE_LINES=$2
        shift 2
        ;;
      --lines=*)
        REMOTE_LINES=${1#--lines=}
        shift
        ;;
      -h | --help)
        remote_usage
        exit 0
        ;;
      --)
        shift
        break
        ;;
      *)
        remote_usage >&2
        remote_usage_error "unknown option for 'genesis remote': $1"
        ;;
    esac
  done

  if [ "$_prf_mode" != start ]; then
    if [ -n "$REMOTE_NODE" ] || [ -n "$REMOTE_COOKIE" ] ||
      [ "$REMOTE_DIST_PORT" != "$REMOTE_DEFAULT_DIST_PORT" ] ||
      [ "$REMOTE_WAIT" != "$REMOTE_DEFAULT_WAIT" ] || [ "$REMOTE_FORCE" = 1 ]; then
      remote_usage_error "--node/--cookie/--dist-port/--wait/--force are only valid for 'genesis remote start'"
    fi
  fi
  if [ "$_prf_mode" != logs ]; then
    if [ "$REMOTE_FOLLOW" = 1 ] || [ "$REMOTE_LINES" != 200 ]; then
      remote_usage_error "--follow/--lines are only valid for 'genesis remote logs'"
    fi
  fi

  validate_port "$REMOTE_DIST_PORT"
  case $REMOTE_UNIT in
    *[!A-Za-z0-9._-]* | '')
      remote_usage_error "invalid --unit: $REMOTE_UNIT"
      ;;
  esac
  case $REMOTE_WAIT in
    *[!0-9]*) die "invalid --wait: $REMOTE_WAIT" ;;
  esac
  # The daemon needs a moment to answer a SIGHUP (and, on a fresh host, to boot
  # at all), so the budget has a floor.
  if [ "$REMOTE_WAIT" -lt "$REMOTE_MIN_WAIT" ]; then
    REMOTE_WAIT=$REMOTE_MIN_WAIT
  fi
  case $REMOTE_LINES in
    '' | *[!0-9]*) die "invalid --lines: $REMOTE_LINES" ;;
  esac
}

# ── Remote commands ──────────────────────────────────────────────────────────

cmd_remote_start() {
  parse_remote_flags start "$@"

  if [ -z "$REMOTE_NODE" ]; then
    remote_usage_error "--node is required for 'genesis remote start'"
  fi
  if [ -z "$REMOTE_COOKIE" ]; then
    remote_usage_error "--cookie is required for 'genesis remote start'"
  fi

  # 1. A bootstrap from before the single-instance model ran a SECOND,
  #    distribution-only daemon per target; two servers must never share a host.
  cleanup_legacy_daemon

  # 2. Remote development is a toggle on the instance, so a fresh host brings
  #    the instance up first — exactly like `genesis start` (HTTP plus the
  #    control plane), and only then enables distribution.
  if ! instance_running; then
    if ! start_and_wait "$(effective_ip)" "$(effective_port)" "$FLAG_HOST"; then
      return 1
    fi
  fi

  # 3. Already enabled for this node: idempotent, and no signal is sent.
  if [ "$REMOTE_FORCE" != 1 ] && dist_enabled_for "$REMOTE_NODE"; then
    print_dist_running
    return 0
  fi

  # 4. Enable distribution at runtime on the running instance.
  _rcs_rc=0
  send_control enable "$REMOTE_NODE" "$REMOTE_COOKIE" "$REMOTE_DIST_PORT" "$REMOTE_WAIT" ||
    _rcs_rc=$?
  case $_rcs_rc in
    0)
      print_dist_running
      return 0
      ;;
    1)
      print_control_message
      return 1
      ;;
    3)
      printf 'The Genesis server instance is not running, so remote development cannot be enabled.\n' >&2
      return 1
      ;;
    *)
      printf 'The Genesis server instance did not answer within %ss.\n' "$REMOTE_WAIT" >&2
      printf 'Recent logs:\n' >&2
      print_logs_tail 20 >&2
      return 1
      ;;
  esac
}

cmd_remote_stop() {
  parse_remote_flags service "$@"

  # Nothing to detach when the instance itself is down: idempotent, exit 0.
  if ! instance_running; then
    printf 'Remote daemon is not running (unit %s).\n' "$REMOTE_UNIT"
    return 0
  fi

  _rcp_rc=0
  send_control disable "" "" "" "$REMOTE_STOP_WAIT" || _rcp_rc=$?
  case $_rcp_rc in
    0)
      # The HTTP instance deliberately keeps running — only distribution is
      # detached. `genesis stop` is what stops the instance itself.
      printf 'Remote daemon stopped (unit %s).\n' "$REMOTE_UNIT"
      return 0
      ;;
    1)
      print_control_message
      return 1
      ;;
    3)
      printf 'The Genesis server instance is not running.\n' >&2
      return 1
      ;;
    *)
      printf 'The Genesis server instance did not answer within %ss.\n' "$REMOTE_STOP_WAIT" >&2
      printf 'Recent logs:\n' >&2
      print_logs_tail 20 >&2
      return 1
      ;;
  esac
}

cmd_remote_status() {
  parse_remote_flags service "$@"

  # Distribution is on only when the instance is up AND dist.env — the daemon's
  # published ACTUAL state — says so. A stale file cannot outlive the instance.
  if ! instance_running; then
    printf 'stopped\n'
    return 1
  fi
  if [ "$(dist_state_get GENESIS_DIST_ENABLED)" != 1 ]; then
    printf 'stopped\n'
    return 1
  fi

  print_dist_running
  return 0
}

cmd_remote_logs() {
  parse_remote_flags logs "$@"

  # One instance, one log: `remote logs` is the instance's log, which now also
  # carries the distribution control-plane messages.
  show_instance_logs "$REMOTE_FOLLOW" "$REMOTE_LINES"
}

cmd_remote() {
  _cr_cmd=${1:-}
  if [ $# -gt 0 ]; then shift; fi

  case $_cr_cmd in
    start)
      require_launcher
      cmd_remote_start "$@"
      ;;
    stop)
      require_launcher
      cmd_remote_stop "$@"
      ;;
    status)
      require_launcher
      cmd_remote_status "$@"
      ;;
    logs)
      require_launcher
      cmd_remote_logs "$@"
      ;;
    help | -h | --help)
      remote_usage
      return 0
      ;;
    '')
      remote_usage >&2
      printf 'genesis: remote needs a command (start|stop|status|logs)\n' >&2
      exit 2
      ;;
    *)
      remote_usage >&2
      printf 'genesis: unknown remote command: %s\n' "$_cr_cmd" >&2
      exit 2
      ;;
  esac
}

# ── Entry point ──────────────────────────────────────────────────────────────

main() {
  if [ $# -eq 0 ]; then
    require_launcher
    cmd_serve
    return 0
  fi

  _cmd=$1
  shift

  case $_cmd in
    help | -h | --help)
      usage
      return 0
      ;;
    serve | run)
      require_launcher
      cmd_serve "$@"
      ;;
    start)
      require_launcher
      cmd_start "$@"
      ;;
    stop)
      require_launcher
      cmd_stop "$@"
      ;;
    restart)
      require_launcher
      cmd_restart "$@"
      ;;
    status)
      require_launcher
      cmd_status "$@"
      ;;
    logs)
      require_launcher
      cmd_logs "$@"
      ;;
    url)
      require_launcher
      cmd_url "$@"
      ;;
    remote)
      cmd_remote "$@"
      ;;
    update | upgrade)
      require_launcher
      cmd_update "$@"
      ;;
    version | --version)
      require_launcher
      cmd_version
      ;;
    *)
      usage >&2
      printf 'genesis: unknown command: %s\n' "$_cmd" >&2
      exit 2
      ;;
  esac
}

main "$@"
