## Customize flags given to the VM: https://www.erlang.org/doc/man/erl.html
## -mode/-name/-sname/-setcookie are configured via env vars, do not set them here

## Increase number of concurrent ports/sockets
##+Q 65536

## Tweak GC to run more often
##-env ERL_FULLSWEEP_AFTER 10

<%= if @release.name == :genesis_remote do %>
## Remote Daemon — EPMD-less distribution over pinned port (for SSH tunneling)
## Uses a custom EPMD module (EvoGit.EpmdDist) that doesn't require an external
## epmd process. The daemon listens on port 9000; SSH tunnels forward to it.
-start_epmd false
-epmd_module Elixir.EvoGit.EpmdDist
-dist_listen true
-kernel inet_dist_listen_min 9000 inet_dist_listen_max 9000
<% else %>
## Local Dashboard — EPMD-less distribution for SSH tunneling to remote nodes.
## Uses a custom EPMD module (EvoGit.EpmdDist) that resolves remote node ports
## from an ETS table populated at runtime by EvoGit.RemoteConnection when an
## SSH tunnel is opened. Distribution is NOT started at boot — it is enabled
## on-demand when a remote connection is initiated (via EvoGit.Distribution).
-start_epmd false
-epmd_module Elixir.EvoGit.EpmdDist
-dist_listen true
-kernel inet_dist_listen_min 9100 inet_dist_listen_max 9200
<% end %>

## -----------------------------------------------------------------------------
## Desktop Optimization Flags
## -----------------------------------------------------------------------------

## Disable Scheduler Busy-Waiting (Saves battery and background CPU)
+sbwt none
+sbwtdcpu none
+sbwtdio none

## Shrink Pre-allocated Table Limits (Lowers baseline idle memory floor)
+P 40000
+t 80000
