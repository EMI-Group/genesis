{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "genesis-desktop",
  "version": "0.8.1",
  "identifier": "com.genesis.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:9999",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Genesis Dashboard",
        "url": "http://localhost:9999",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/genesis-backend"
    ],
    "publisher": "Genesis",
    "copyright": "Copyright © 2025 Genesis. All rights reserved.",
    "category": "DeveloperTool",
    "shortDescription": "Evolutionary software development with AI agents",
    "longDescription": "Genesis is an evolutionary software development framework where AI agents create, analyze, and modify codebases."
  }
}
