{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the Genesis desktop shell: shell access for the Phoenix backend sidecar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "allow-begin-quit",
    "allow-dashboard-ready",
    "allow-check-update",
    "allow-download-update",
    "allow-begin-update"
  ],
  "remote": {
    "urls": [
      "http://localhost:*",
      "http://127.0.0.1:*"
    ]
  }
}
