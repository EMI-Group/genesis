# Copy to desktop/scripts/.env.macos and fill in:
#   cp desktop/scripts/.env.macos.example desktop/scripts/.env.macos

# Signing identity:
#   security find-identity -v -p codesigning
APPLE_SIGNING_IDENTITY=

# Notarization — App Store Connect API key
APPLE_API_ISSUER=
APPLE_API_KEY=
APPLE_API_KEY_PATH=

# Or Apple ID + app-specific password (comment out the API key vars above)
# APPLE_ID=
# APPLE_PASSWORD=
# APPLE_TEAM_ID=
