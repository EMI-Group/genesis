{application,evo_dash,
             [{modules,['Elixir.EvoDash','Elixir.EvoDash.Application',
                        'Elixir.EvoDash.TaskRegistry',
                        'Elixir.EvoDash.TaskRegistry.TaskInfo',
                        'Elixir.EvoDashWeb',
                        'Elixir.EvoDashWeb.AgentsComponents',
                        'Elixir.EvoDashWeb.AgentsLive',
                        'Elixir.EvoDashWeb.ConnCase',
                        'Elixir.EvoDashWeb.CoreComponents',
                        'Elixir.EvoDashWeb.DashboardComponents',
                        'Elixir.EvoDashWeb.DashboardLive',
                        'Elixir.EvoDashWeb.Endpoint',
                        'Elixir.EvoDashWeb.ErrorHTML',
                        'Elixir.EvoDashWeb.ErrorJSON',
                        'Elixir.EvoDashWeb.Layouts',
                        'Elixir.EvoDashWeb.PageController',
                        'Elixir.EvoDashWeb.PageHTML',
                        'Elixir.EvoDashWeb.Router',
                        'Elixir.EvoDashWeb.Telemetry']},
              {compile_env,[{evo_dash,['Elixir.EvoDashWeb.Endpoint',
                                       code_reloader],
                                      error},
                            {evo_dash,['Elixir.EvoDashWeb.Endpoint',
                                       debug_errors],
                                      error},
                            {evo_dash,['Elixir.EvoDashWeb.Endpoint',force_ssl],
                                      error}]},
              {optional_applications,[]},
              {applications,[kernel,stdlib,elixir,logger,runtime_tools,
                             evo_git,phoenix,phoenix_html,phoenix_live_view,
                             phoenix_live_dashboard,lazy_html,
                             telemetry_metrics,telemetry_poller,jason,
                             dns_cluster,bandit]},
              {description,"evo_dash"},
              {registered,[]},
              {vsn,"0.1.0"},
              {mod,{'Elixir.EvoDash.Application',[]}}]}.
